/* pages/user/myinfo.wxss */
page{
	background-color: #ebf6fc;
}
.banner{
	width: 100%;
	height: 170rpx;
	background-color: #055586;
	position: absolute;
	top: 0;
	z-index: -1;
}
.main{
	margin-top: 30rpx;
	z-index: 99;
}
.form{
	width: 100%;
	background-color: #fff;
	padding: 25rpx;
	padding-bottom: 100rpx;
	border-radius: 25rpx;
	box-sizing: border-box;
	margin-bottom: 25rpx;
}
.form .item{
	width: 100%;
	height: 100rpx;
	display: flex;
	justify-content: space-between;
	align-items: center;
	border-bottom: 1rpx solid #eee;
}
.form .item .l{
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-size: 14px;
}
.form .item .r{
	width: 65%;
	display: flex;
	justify-content: flex-end;
	align-items: center;
	font-size: 14px;
}
.form .item .r .gettx{
	width: 70rpx;
	height: 70rpx;
	background-color: unset;
	margin: 0;
	padding: 0;
	border:1rpx solid #ddd;
	border-radius: 50%;
}
.form .item .r .gettx image{
	width: 100%;
	height: auto;
	border-radius: 50rpx;
}
.form .item .r .input{
	margin-right: 10rpx;
	text-align: right;
}
.form .item .r .gettel{
	padding: 0 15rpx;
    color: #fff;
    font-size: 12px;
    background-color: #07c160;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    height: 45rpx;
    border-radius: 25rpx;
    width: 190rpx;
    box-sizing: border-box;
    margin: 0;
    margin-bottom: 10rpx;
}
.form .item .r .gettel .img{
	width: 25rpx;
	height: auto;
	margin-right: 10rpx;
	max-height: 13px;
}
.form .item .r .sj{
	width: 15rpx;
	height: auto;
}
.tips{
	width: 100%;
	font-size: 12px;
	color: #aaa;
	margin-bottom: 25rpx;
}
.save{
	width: 100%;
	height: 80rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	color: #fff;
	background-color: #055586;
	font-size: 14px;
	border-radius: 15rpx;
}
.form .item .r .gettx2{
	padding: 0 15rpx;
	color: #fff;
	font-size: 12px;
	background-color: #07c160;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	height: 45rpx;
	border-radius: 25rpx;
	width: max-content;
	box-sizing: border-box;
	margin: 0;
	margin-bottom: 10rpx;
}
.form .item .r .gettx2 .img{
	width: 25rpx;
	height: auto;
	margin-right: 10rpx;
	max-height: 13px;
}