/* pages/user/join.wxss */
page{
	background-color: #055586;
}
.back{
	position: fixed;
	top: 62rpx;
	left: 25rpx;
	width: 20rpx;
}
.back image{
	width: 100%;
	height: auto;
}
.tupian{
	width: 100%;
}
.tupian image{
	width: 100%;
	height: auto;
}
.con{
	width: 100%;
	padding: 0 50rpx;
	margin-top: -125rpx;
	box-sizing: border-box;
}
.con .item{
	width: 100%;
	position: relative;
}
.con .item .bj{
	width: 100%;
	height: auto;
}
.con .item .neirong{
	position: absolute;
	width: 100%;
	height: 100%;
	top: 0;
	left: 0;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	padding-left: 75rpx;
	padding-top: 20px;
	box-sizing: border-box;
}
.con .item .neirong .l{
	width: 175rpx;
	margin-right: 40rpx;
}
.con .item .neirong .l image{
	width: 100%;
	height: 100%;
}
.con .item .neirong .r{

}
.con .item .neirong .r .p{
	min-width: 240rpx;
	height: 45rpx;
	box-sizing: border-box;
	background-color: #edb556;
	border:2px solid #333;
	position: relative;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-size: 14px;
	color: #333;
	margin-bottom: 15rpx;
	padding-left: 25rpx;
}
.con .item .neirong .r .p:last-child{
	margin-bottom: 0;
}
.con .item .neirong .r .p .img{
	width: 15rpx;
	height: auto;
	/* max-width: 12rpx; */
	position: absolute;
	top: 0;
	bottom: 0;
	left: -15rpx;
	margin: auto;
}