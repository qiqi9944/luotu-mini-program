/* pages/user/user.wxss — 我的：账户头卡 + 分组设置项 */
page {
	background-color: var(--paper);
}

/* 顶部墨蓝带（衬在内容之下），与其余三个 tab 页同一语言 */
.banner {
	width: 100%;
	height: 300rpx;
	position: absolute;
	top: 0;
	left: 0;
	z-index: -1;
	overflow: hidden;
	background: linear-gradient(160deg, var(--ink-700) 0%, var(--ink-900) 100%);
}
.banner::before {
	content: "";
	position: absolute;
	left: -20%;
	top: -60%;
	width: 140%;
	height: 260%;
	background-image: repeating-linear-gradient(
			45deg,
			rgba(255, 255, 255, 0.045) 0 1rpx,
			transparent 1rpx 24rpx
		),
		repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.03) 0 1rpx, transparent 1rpx 24rpx);
}
.banner::after {
	content: "";
	position: absolute;
	right: -80rpx;
	top: -140rpx;
	width: 420rpx;
	height: 420rpx;
	border-radius: 50%;
	background: radial-gradient(circle, rgba(46, 134, 184, 0.42) 0%, rgba(46, 134, 184, 0) 70%);
}

.main {
	padding: 0 var(--gutter);
}

/* ---------- 账户头卡 ---------- */
.top {
	width: 100%;
	box-sizing: border-box;
	margin-top: 40rpx;
	margin-bottom: 32rpx;
	padding: 44rpx 32rpx;
	background-color: var(--surface);
	border-radius: var(--r-lg);
	box-shadow: var(--shadow-lift);
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.top .l {
	flex: 1;
	min-width: 0;
}
.top .l .p1 {
	width: 100%;
	margin-bottom: 16rpx;
	font-size: var(--fs-heading);
	font-weight: 600;
	line-height: 1.2;
	color: var(--text-1);
	letter-spacing: 1rpx;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
/* 公司名沿用原先的金色调，收敛到体系内的琥珀信号色 */
.top .l .p2 {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-size: var(--fs-body-s);
	color: #8a4f05;
}
.top .l .p2::before {
	content: "";
	width: 8rpx;
	height: 8rpx;
	margin-right: 12rpx;
	flex-shrink: 0;
	border-radius: 50%;
	background-color: var(--signal);
}
.top .l .p4 {
	font-size: var(--fs-body-s);
	color: var(--text-3);
}

/* 未登录态：一行小标 + 微信绿按钮（沿用微信官方色，符合平台惯例） */
.top .l .p5 {
	margin-bottom: 20rpx;
	font-family: var(--font-num);
	font-size: var(--fs-caption);
	letter-spacing: 2rpx;
	color: var(--text-3);
}
.top .l .p3 {
	width: max-content;
	height: 68rpx;
	margin: 0 0 16rpx;
	padding: 0 32rpx;
	box-sizing: border-box;
	display: flex;
	justify-content: center;
	align-items: center;
	background-color: #07c160;
	border-radius: 999rpx;
	font-size: var(--fs-body-s);
	font-weight: 500;
	color: var(--text-invert);
	letter-spacing: 1rpx;
	line-height: 1;
}
.top .l .p3::after {
	border: none;
}

/* 头像：外圈发丝环，把它从背景里托出来 */
.top .r {
	width: 116rpx;
	height: 116rpx;
	margin-left: 24rpx;
	flex-shrink: 0;
	border-radius: 50%;
	background-color: var(--surface-sunken);
	box-shadow: 0 0 0 2rpx var(--surface), 0 0 0 4rpx var(--ink-050);
}

/* ---------- 分组标题 ---------- */
.group-title {
	padding: 0 8rpx 14rpx;
	font-size: var(--fs-body-s);
	color: var(--text-3);
	letter-spacing: 3rpx;
}

/* ---------- 设置项列表 ---------- */
.list {
	width: 100%;
	box-sizing: border-box;
	padding: 0 var(--gutter);
	margin-bottom: 32rpx;
	background-color: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: var(--r-lg);
	box-shadow: var(--shadow-card);
	overflow: hidden;
}
.list .item {
	width: 100%;
	height: 108rpx;
	padding: 0;
	margin: 0;
	box-sizing: border-box;
	border-bottom: 1rpx solid var(--hairline);
	border-radius: 0;
	display: flex;
	justify-content: space-between;
	align-items: center;
	background-color: transparent;
	font-weight: normal;
	line-height: normal;
	text-align: left;
}
/* button 元素在小程序里自带 ::after 边框，需要清掉才能与 view 行对齐 */
.list .item::after {
	border: none;
}
.list .item:last-child {
	border-bottom: 0;
}
.list .item .l {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-size: var(--fs-body);
	color: var(--text-1);
}

/* 图标底托：淡墨蓝方块，让形状各异的图标获得统一的视觉重量 */
.list .item .l .ico {
	width: 56rpx;
	height: 56rpx;
	margin-right: 20rpx;
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: var(--r-sm);
	background-color: var(--ink-050);
}
.list .item .l .ico .img {
	width: 32rpx;
	max-height: 32rpx;
}
.list .item .r {
	width: 14rpx;
	max-height: 24rpx;
	flex-shrink: 0;
	opacity: 0.45;
}

/* 退出登录单独成组，文字转为警示色，避免与常规入口混排误触 */
.list--danger .item .l {
	color: var(--rise);
}
.list--danger .item .l .ico {
	background-color: rgba(210, 64, 41, 0.08);
}
