/* pages/user/about.wxss */
page {
	background-color: #055586;
}
.aa{
	box-sizing: border-box;
	padding: 0 25rpx;
	padding-bottom: 30px;
	width: 100%;
	background-color: #ebf6fc;
	margin-top: 30rpx;
	border-radius: 15rpx 15rpx 0 0 ;
}
.box{
	width: 100%;
	background-color: #fff;
	border-radius: 15rpx;
	padding: 25rpx;
	box-sizing: border-box;
}
.pubtitle{
	width: 100%;
	position: relative;
	display: flex;
	justify-content: flex-start;
	align-items: center;
}
.pubtitle .bj{
	width:35rpx;
	height:35rpx;
	margin-right: 10rpx;
}
.pubtitle .text{
	height: 37px;
	box-sizing: border-box;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	z-index: 2;
}
.pubtitle .text .a1{
	font-size: 14px;
	color: #333;
	font-weight: bold;
	margin-right: 15rpx;
}
.pubtitle .text .a2{
	font-size: 14px;
	color: #ddd;
	font-weight: bold;
}
.abcon1{
	width: 100%;
	margin-bottom: 20rpx;
}
.abcon1 .p1{
	width: 100%;
	display: flex;
	justify-content: center;
	align-items: center;
	padding: 40rpx 0;
}
.abcon1 .p1 image{
	width: 400rpx;
	max-height: 50px;
}
.abcon1 .p2{
	width: 100%;
	text-indent: 2em;
	line-height: 24px;
	font-size: 12px;
	color: #333;
	text-align: justify;
}
.abcon2{
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: stretch;
	flex-wrap: wrap;
	padding: 20rpx 0;
}
.abcon2 .item{
	width: calc((100% - 40rpx)/3);
	margin-bottom: 20rpx;
	position: relative;
}
.abcon2 .item:nth-last-child(1),.abcon2 .item:nth-last-child(2),.abcon2 .item:nth-last-child(3){
	margin-bottom: 0;
}
.abcon2 .item .img{
	width: 100%;
	height: auto;
}
.abcon2 .item .title{
	width: 100%;
	height: 40rpx;
	background-color: rgba(0, 0, 0, 0.47);
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 12px;
	color: #fff;
	position: absolute;
	left: 0;
	bottom: 4px;
	border-radius: 0 0 10rpx 10rpx;
}