/* pages/tongji/tongji.wxss — 数据页：行情终端式的指标与表格 */
page {
	background-color: #eef3f8;
}

/* 版权水印。原实现用 10000vw × 10000vh 的图层配合 20 位数的 z-index，
   合成层面积巨大且 z-index 早已溢出被钳制；这里收敛到可控尺寸与量级，
   视觉效果不变，滚动时的合成开销大幅下降。 */
page::before {
	content: "";
	position: fixed;
	left: 50%;
	top: 50%;
	width: 280vw;
	height: 280vh;
	z-index: 999;
	pointer-events: none;
	opacity: 0.05;
	background-image: url(https://luotu.tianjin8.com/Public/images/logo.png);
	background-repeat: repeat;
	background-size: 250px;
	transform: translate(-50%, -50%) rotate(-45deg);
}

/* ---------- 顶部品类切换带 ---------- */
.sellist2 {
	position: relative;
	width: 100%;
	padding: 44rpx 0 100rpx;
	box-sizing: border-box;
	display: flex;
	justify-content: space-around;
	align-items: flex-start;
	overflow: hidden;
	background: linear-gradient(160deg, var(--ink-700) 0%, var(--ink-900) 100%);
}
.sellist2::before {
	content: "";
	position: absolute;
	left: -20%;
	top: -60%;
	width: 140%;
	height: 260%;
	pointer-events: none;
	background-image: repeating-linear-gradient(
			45deg,
			rgba(255, 255, 255, 0.045) 0 1rpx,
			transparent 1rpx 24rpx
		),
		repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.03) 0 1rpx, transparent 1rpx 24rpx);
}

.sellist2::after {
	content: "";
	position: absolute;
	right: -80rpx;
	top: -140rpx;
	width: 420rpx;
	height: 420rpx;
	border-radius: 50%;
	pointer-events: none;
	background: radial-gradient(circle, rgba(46, 134, 184, 0.42) 0%, rgba(46, 134, 184, 0) 70%);
}

.sellist2 .item {
	position: relative;
	z-index: 1;
	width: 25%;
	display: flex;
	flex-direction: column;
	justify-content: flex-start;
	align-items: center;
}
.sellist2 .item .title {
	padding: 0 6rpx;
	text-align: center;
	font-size: var(--fs-body-s);
	line-height: 1.3;
	/* 原 rgba(255,255,255,.3) 在深蓝上仅约 1.5:1，属于不可读；提到 .62 */
	color: rgba(255, 255, 255, 0.62);
	transition: color 0.2s ease;
}
.sellist2 .item.hover .title {
	color: var(--text-invert);
	font-weight: 600;
}
.sellist2 .item .pic {
	width: 84rpx;
	height: 84rpx;
	border-radius: 50%;
	box-sizing: border-box;
	background-color: rgba(255, 255, 255, 0.1);
	border: 1rpx solid rgba(255, 255, 255, 0.16);
	display: flex;
	justify-content: center;
	align-items: center;
	margin-bottom: 16rpx;
	transition: background-color 0.2s ease, box-shadow 0.2s ease;
}
/* 选中态：白底 + 一圈外发光，在深色带上形成明确的焦点 */
.sellist2 .item.hover .pic {
	background-color: var(--surface);
	border-color: var(--surface);
	box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.14);
}
.sellist2 .item .pic image {
	width: 40rpx;
	max-height: 44rpx;
}

/* ---------- 内容纸面 ---------- */
.con {
	position: relative;
	z-index: 99;
	box-sizing: border-box;
	padding: 24rpx 18rpx 0;
	margin-top: -42rpx;
	background-color: #eef3f8;
	border-radius: 22rpx 22rpx 0 0;
	box-shadow: none;
}
.con2 {
	min-height: calc(100vh - 300rpx);
	display: flex;
	justify-content: center;
	align-items: center;
	flex-direction: column;
}
.con2 .pic {
	width: 250rpx;
	margin-bottom: 28rpx;
	opacity: 0.8;
}
.con2 .text {
	font-size: var(--fs-body);
	color: var(--text-3);
	letter-spacing: 1rpx;
}

/* ---------- 页内大标题 + 筛选器 ---------- */
.bigtitle {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 24rpx;
}
.bigtitle .l {
	font-size: var(--fs-heading);
	font-weight: 600;
	color: var(--text-1);
	letter-spacing: 1rpx;
}
.bigtitle .r {
	display: flex;
	justify-content: flex-end;
	align-items: center;
}
.bigtitle .r picker {
	margin-left: 16rpx;
}

/* 筛选器改为「可见控件」：原来只是一段灰字加小三角，看不出可点。
   统一给出胶囊底、发丝描边与右侧箭头。 */
.bigtitle .l .picker {
	display: inline-flex;
	align-items: center;
	max-width: 420rpx;
	padding: 10rpx 20rpx;
	box-sizing: border-box;
	background-color: var(--surface);
	border: 1rpx solid var(--hairline-strong);
	border-radius: 999rpx;
	box-shadow: var(--shadow-card);
	font-size: var(--fs-title);
	font-weight: 600;
	color: var(--text-1);
}
.bigtitle .l .picker .sj {
	width: 16rpx;
	margin-left: 14rpx;
	flex-shrink: 0;
	max-height: 12rpx;
}
.bigtitle .r .picker,
.box .up .r .picker,
.seltd .picker {
	display: inline-flex;
	align-items: center;
	padding: 8rpx 16rpx;
	box-sizing: border-box;
	background-color: var(--surface-sunken);
	border: 1rpx solid var(--hairline);
	border-radius: 999rpx;
	font-size: var(--fs-body-s);
	color: var(--text-2);
}
.bigtitle .r .picker .sj,
.box .up .r .picker .sj,
.seltd .picker .sj {
	width: 14rpx;
	margin-left: 10rpx;
	flex-shrink: 0;
	max-height: 10rpx;
	opacity: 0.6;
}

/* ---------- 数据卡 ---------- */
.box {
	width: 100%;
	padding: 0;
	box-sizing: border-box;
	background-color: var(--surface);
	border: 1rpx solid rgba(24, 58, 95, 0.08);
	border-radius: 16rpx;
	margin-bottom: 18rpx;
	overflow: hidden;
	box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
}
.box .up {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 20rpx 20rpx 16rpx;
	box-sizing: border-box;
	margin-bottom: 0;
	background: #fff;
	border-bottom: 1rpx solid rgba(24, 58, 95, 0.06);
}
.box .up2 {
	align-items: flex-end;
}
.box .up3 {
	box-sizing: border-box;
	margin-bottom: 0;
}
.box .up4 {
	box-sizing: border-box;
	padding: 20rpx 20rpx 16rpx;
	margin-bottom: 0;
	border-bottom: 1rpx solid rgba(24, 58, 95, 0.06);
}
.box .up .l {
	display: flex;
	justify-content: flex-start;
	align-items: center;
}
.box .up .l .title {
	font-size: 28rpx;
	line-height: 1.2;
	font-weight: 700;
	color: #17344d;
	letter-spacing: 0;
}
.box .up .r {
	display: flex;
	justify-content: flex-end;
	align-items: center;
	margin-right: 0;
}
.box .up .r picker {
	margin-left: 16rpx;
}

/* 两根小竖条原为红色方块，与「红＝上涨」的语义冲突。
   改成墨蓝的递增双柱，正好读作一枚微型柱状图字符。 */
.box .up .l .fk {
	width: 4rpx;
	height: 16rpx;
	margin-right: 5rpx;
	border-radius: 6rpx;
	background-color: rgba(0, 93, 153, 0.28);
	flex-shrink: 0;
}
.box .up .l .fk2 {
	width: 4rpx;
	height: 24rpx;
	margin-right: 12rpx;
	border-radius: 6rpx;
	background-color: var(--ink-600);
	flex-shrink: 0;
}

/* 卡内左上角的次级筛选列 */
.box .up .l2 {
	margin-left: 0;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	justify-content: flex-start;
}
.box .up .l2 .select {
	margin-bottom: 16rpx;
}
.box .up .l2 .select:last-child {
	margin-bottom: 0;
}
.box .up .l2 .select .picker {
	box-sizing: border-box;
	min-width: 188rpx;
	height: 50rpx;
	padding: 0 14rpx;
	background-color: #fff;
	border: 1rpx solid #d7e1ea;
	border-radius: 12rpx;
	font-size: 22rpx;
	color: #4d6478;
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-shadow: none;
}
.box .up .l2 .select .picker .sanjiao {
	width: 14rpx;
	opacity: 0.6;
}

/* 分段切换（墨蓝描边，替换原先的 #2489f0 亮蓝） */
.box .up .r .item {
	width: 84rpx;
	height: 40rpx;
	box-sizing: border-box;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: var(--fs-caption);
	color: #1f6b9d;
	border: 1rpx solid rgba(31, 107, 157, 0.5);
	background-color: var(--surface);
}
.box .up .r .item.hover {
	background-color: #1f6b9d;
	color: var(--text-invert);
}
.box .up .r .item:first-child {
	border-radius: var(--r-sm) 0 0 var(--r-sm);
}
.box .up .r .item:last-child {
	border-radius: 0 var(--r-sm) var(--r-sm) 0;
	margin-right: var(--gutter);
}

/* 数据来源脚注 */
.tips {
	width: 100%;
	box-sizing: border-box;
	padding: 0 var(--gutter);
	margin-top: 8rpx;
	font-size: var(--fs-caption);
	line-height: 1.5;
	color: var(--text-3);
	text-align: right;
}

.data-stack {
	width: 100%;
}

/* 供应链分组卡：对齐 filter 页的轻卡片 + 组标题 + 可点行 */
.subbox {
	width: 100%;
	box-sizing: border-box;
	margin-bottom: 18rpx;
	background: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: 16rpx;
	box-shadow: var(--shadow-card);
	overflow: hidden;
}

.tvsgroup-hd {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 18rpx 20rpx 12rpx;
	border-bottom: 1rpx solid #e2edf5;
}

.tvsgroup-title {
	font-size: 26rpx;
	font-weight: 700;
	color: #1a6fa0;
}

.tvsgroup-periodpicker {
	display: inline-flex;
	align-items: center;
	gap: 8rpx;
	padding: 6rpx 12rpx;
	border-radius: 999rpx;
	background: #f7fbff;
	border: 1rpx solid #d7e1ea;
}

.tvsgroup-period {
	font-size: 22rpx;
	color: #567089;
}

.tvslist {
	padding: 0 20rpx 6rpx;
}

.tvsrow {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 22rpx 0;
	border-bottom: 1rpx solid #f0f4f7;
}

.tvsrow:last-child {
	border-bottom: 0;
}

.tvsrow-name {
	font-size: 26rpx;
	color: #334155;
	flex: 1;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.tvsrow-right {
	display: flex;
	align-items: center;
	gap: 4rpx;
	flex-shrink: 0;
}

.tvsrow-qty {
	font-size: 30rpx;
	font-weight: 700;
	color: #0e608d;
}

.tvsrow-unit {
	font-size: 22rpx;
	color: #7d8a99;
}

.tvsrow-yoy {
	display: flex;
	align-items: center;
	gap: 4rpx;
	font-size: 22rpx;
	font-weight: 600;
	min-width: 80rpx;
	justify-content: flex-end;
	color: #7d8a99;
}

.tvsrow-yoy.up {
	color: #e24a5a;
}

.tvsrow-yoy.down {
	color: #2f9e79;
}

.subarrow {
	width: 14rpx;
	height: auto;
	max-height: 18rpx;
	flex-shrink: 0;
}

.box .down {
	width: 100%;
	box-sizing: border-box;
	padding: 0 20rpx 16rpx;
	margin-bottom: 0;
}

/* ---------- 卡内并列指标：数字为主角，标签退居其下 ---------- */
.box .down .tjlist {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: stretch;
	margin-bottom: 32rpx;
}
.box .down .tjlist .item {
	flex: 1;
	min-width: 0;
	display: flex;
	justify-content: center;
	align-items: flex-start;
	flex-direction: column;
	padding-right: 20rpx;
	box-sizing: border-box;
}
/* 指标之间用一道发丝线分栏，比单纯留白更利于比对 */
.box .down .tjlist .item + .item {
	padding-left: 28rpx;
	padding-right: 0;
	border-left: 1rpx solid var(--hairline);
}
.box .down .tjlist .item .p1 {
	font-size: var(--fs-body-s);
	color: var(--text-3);
	letter-spacing: 1rpx;
}
.box .down .tjlist .item .p2 {
	display: flex;
	justify-content: flex-start;
	align-items: baseline;
	flex-wrap: wrap;
	margin-bottom: 10rpx;
}
.box .down .tjlist .item .p2 .a1 {
	display: flex;
	justify-content: flex-start;
	align-items: baseline;
	margin-right: 14rpx;
	font-size: var(--fs-body-s);
	color: var(--text-3);
}
.box .down .tjlist .item .p2 .a1 .num {
	margin-right: 6rpx;
	font-size: var(--fs-metric);
	font-weight: 700;
	line-height: 1.1;
	color: var(--ink-700);
}

/* .red 原本在 wxml 里被用于「销售金额」却没有对应样式。
   这里赋予它琥珀色：量为墨蓝、额为琥珀，一眼区分两类指标。 */
.box .down .tjlist .item .p2 .a1.red .num {
	color: var(--signal);
}

/* 同比：做成带底色的小胶囊，涨跌方向比数值本身更先被读到 */
.box .down .tjlist .item .p2 .a2 {
	padding: 2rpx 12rpx;
	border-radius: 999rpx;
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-body-s);
	font-weight: 700;
	color: var(--flat);
	background-color: var(--surface-sunken);
}
.box .down .tjlist .item .p2 .a2.a2_1 {
	color: var(--rise);
	background-color: rgba(210, 64, 41, 0.08);
}
.box .down .tjlist .item .p2 .a2.a2_2 {
	color: var(--fall);
	background-color: rgba(11, 143, 99, 0.08);
}

/* ---------- 表格（继承 app.wxss 的横线体系，此处只补页面语境） ---------- */
.box .down .table {
	border: 0;
	margin-bottom: 24rpx;
}
.box .down .table .num {
	margin-right: 8rpx;
	font-size: var(--fs-body);
	font-weight: 700;
	color: var(--ink-700);
}
.box .down .table .num2 {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-size: var(--fs-caption);
	font-weight: 700;
}
.box .down .table .num2 .img {
	width: 14rpx;
	margin-left: 8rpx;
	max-height: 18rpx;
}
.box .down .table .num3 {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-size: 18rpx;
	font-weight: 700;
}
.box .down .table .juzhong {
	display: flex;
	justify-content: center;
	align-items: center;
	flex-direction: column;
}

/* 表头里承载分组名的单元格：升级为组标题的量级 */
.titletd {
	justify-content: flex-start;
	padding-left: 12rpx;
	font-size: 24rpx;
	font-weight: 700;
	color: #17344d;
	letter-spacing: 0;
	background: transparent;
	border-left: 4rpx solid #1677c8;
}

/* 首列可点进详情，用墨蓝字色 + 右侧小箭头把「可点」说清楚 */
.titletd2 {
	justify-content: flex-start;
	padding-left: 12rpx;
	font-size: 24rpx;
	color: #35556f;
	font-weight: 500;
	background: transparent;
}
.titletd2::after {
	content: "";
	width: 10rpx;
	height: 10rpx;
	margin-left: 10rpx;
	flex-shrink: 0;
	border-top: 2rpx solid var(--ink-200);
	border-right: 2rpx solid var(--ink-200);
	transform: rotate(45deg);
}

.seltd {
	justify-content: flex-end;
	padding-right: 0;
	background: transparent;
}

/* ---------- 续表：同一组指标，另一个统计周期 ----------
   「电视供应链」下面挂着一张季度续表，它的表头没有组名，只悬着一枚周期
   选择器。沿用组标题样式时，屏幕上就出现一条没有标题的组标记加一个看不出
   从属关系的 picker，读起来像渲染出错。这里把它降级成一条「周期条」：
   撤掉组标记、压低行高、标签退到脚注量级，并与上方主表焊成一体，
   让「同一张表换个周期看」这层语义自己说清楚。 */
.box .down .table--lead {
	border-bottom-left-radius: 0;
	border-bottom-right-radius: 0;
}
.box .down .table--cont {
	border-top-left-radius: 0;
	border-top-right-radius: 0;
}

.box .down .table .tr--period .th {
	min-height: 50rpx;
	padding-top: 0;
	padding-bottom: 0;
	/* 主表末行的 border-bottom 被 .tr:last-child 清掉了，接缝由这里补一条 */
	border-top: 1rpx solid #e2edf5;
}

/* 覆盖 .titletd 的组标题量级：撤掉左侧墨条，字重与颜色降到说明文字 */
.titletd--period {
	border-left: 0;
	padding-left: 0;
	font-size: 22rpx;
	font-weight: 400;
	color: var(--text-3);
	letter-spacing: 0;
}

.box .down .table .tr:first-child .th {
	background: #fff;
	border-bottom-color: #e2edf5;
}

.box .down .table .tr:first-child .seltd .picker {
	background-color: #fff;
	border-color: #d7e1ea;
	box-shadow: none;
	color: #4d6478;
}

.box .down .table .tr:first-child .titletd2 {
	color: #17344d;
	font-weight: 600;
}

.box .down .table .tr {
	background: #fff;
}

.box .down .table .td,
.box .down .table .th {
	border-color: #e7eef5;
}

.box .down .table .td {
	font-size: 24rpx;
	color: #334155;
}

.box .down .table .td .dw {
	font-size: 20rpx;
	color: #7d8a99;
}

.box .down .table .tr:nth-child(odd) .td {
	background: #fcfdff;
}

/* ---------- 图表 ---------- */
ec-canvas {
	width: 100%;
	height: 100%;
}
.chart {
	width: 100%;
	height: 300px;
	box-sizing: border-box;
	display: flex;
	justify-content: center;
	align-items: center;
	background-color: var(--surface);
	border-radius: var(--r-md);
}
.chart2 {
	padding: 0 var(--gutter);
}

/* ---------- 三联指标卡（品类详情顶部） ---------- */
.tjlist2 {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: stretch;
	margin-bottom: 24rpx;
}
.tjlist2 .item {
	width: calc((100% - 32rpx) / 3);
	box-sizing: border-box;
	padding: 28rpx 16rpx;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	flex-direction: column;
	background-color: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: var(--r-md);
	box-shadow: var(--shadow-card);
}
.tjlist2 .item .p1 {
	width: 100%;
	text-align: center;
	margin-bottom: 16rpx;
	font-size: var(--fs-caption);
	line-height: 1.3;
	color: var(--text-3);
	letter-spacing: 1rpx;
}
.tjlist2 .item .p2 {
	display: flex;
	justify-content: center;
	align-items: baseline;
	margin-bottom: 14rpx;
	white-space: nowrap;
}
.tjlist2 .item .p2 .num {
	font-size: 44rpx;
	font-weight: 700;
	line-height: 1.1;
	color: var(--ink-700);
}
.tjlist2 .item .p2 .dw {
	margin-left: 4rpx;
	font-size: var(--fs-caption);
	font-weight: 400;
	color: var(--text-3);
}

.tjlist2 .item .p3 {
	display: flex;
	justify-content: center;
	align-items: center;
}
.tjlist2 .item .p3 .a1 {
	font-size: var(--fs-caption);
	color: var(--text-3);
}
.tjlist2 .item .p3 .a2 {
	margin: 0 8rpx;
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-body-s);
	font-weight: 700;
}
.tjlist2 .item .p3 .a3 {
	width: 14rpx;
	max-height: 18rpx;
}

