/* ---------- 内容纸面 ---------- */
.con {
	position: relative;
	z-index: 99;
	box-sizing: border-box;
	padding: 24rpx 18rpx 0;
	margin-top: -42rpx;
	background-color: var(--paper);
	border-radius: var(--r-lg) var(--r-lg) 0 0;
	box-shadow: none;
}
.con2 {
	min-height: calc(100vh - 300rpx);
	display: flex;
	justify-content: center;
	align-items: center;
	flex-direction: column;
}
.con2 .pic {
	width: 250rpx;
	margin-bottom: 28rpx;
	opacity: 0.8;
}
.con2 .text {
	font-size: var(--fs-body);
	color: var(--text-3);
	letter-spacing: 1rpx;
}

/* ---------- 页内大标题 + 筛选器 ---------- */
.bigtitle {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 24rpx;
}
.bigtitle .l {
	font-size: var(--fs-heading);
	font-weight: 600;
	color: var(--text-1);
	letter-spacing: 1rpx;
}
/* 筛选器改为「可见控件」：原来只是一段灰字加小三角，看不出可点。
   统一给出胶囊底、发丝描边与右侧箭头。 */
.bigtitle .l .picker {
	display: inline-flex;
	align-items: center;
	max-width: 420rpx;
	padding: 10rpx 20rpx;
	box-sizing: border-box;
	background-color: var(--surface);
	border: 1rpx solid var(--hairline-strong);
	border-radius: 999rpx;
	box-shadow: var(--shadow-card);
	font-size: var(--fs-title);
	font-weight: 600;
	color: var(--text-1);
}
.bigtitle .l .picker .sj {
	width: 16rpx;
	margin-left: 14rpx;
	flex-shrink: 0;
	max-height: 12rpx;
}
.box .up .r .picker {
	display: inline-flex;
	align-items: center;
	padding: 8rpx 16rpx;
	box-sizing: border-box;
	background-color: var(--surface-sunken);
	border: 1rpx solid var(--hairline);
	border-radius: 999rpx;
	font-size: var(--fs-body-s);
	color: var(--text-2);
}
.box .up .r .picker .sj {
	width: 14rpx;
	margin-left: 10rpx;
	flex-shrink: 0;
	max-height: 10rpx;
	opacity: 0.6;
}

/* ---------- 数据卡 ---------- */
.box {
	width: 100%;
	padding: 0;
	box-sizing: border-box;
	background-color: var(--surface);
	border: 1rpx solid rgba(24, 58, 95, 0.08);
	border-radius: 16rpx;
	margin-bottom: 18rpx;
	overflow: hidden;
	box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
}

/* 分组容器：把「汇总卡 + 明细表」两段并进同一张外框，明确它们属于同一品类组。
   外框承载卡片外观（描边/圆角/阴影），内部两个 .box 退化为无外观的分区，中间一道分隔线。 */
.group-wrap {
	background-color: var(--surface);
	border: 1rpx solid rgba(24, 58, 95, 0.08);
	border-radius: 16rpx;
	box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
	margin-bottom: 24rpx;
	overflow: hidden;
}
.box.group-head,
.box.group-body {
	border: 0;
	border-radius: 0;
	box-shadow: none;
	margin-bottom: 0;
	background-color: transparent;
}
.box.group-head {
	border-bottom: 1rpx solid var(--hairline);
}
.box .up {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 20rpx 20rpx 16rpx;
	box-sizing: border-box;
	margin-bottom: 0;
	background-color: var(--surface);
	border-bottom: 1rpx solid var(--hairline);
}
.box .up4 {
	box-sizing: border-box;
	padding: 20rpx 20rpx 16rpx;
	margin-bottom: 0;
	border-bottom: 1rpx solid var(--hairline);
}
.box .up .l {
	display: flex;
	justify-content: flex-start;
	align-items: center;
}
.box .up .l .title {
	font-size: var(--fs-body);
	line-height: 1.2;
	font-weight: 700;
	color: var(--ink-800);
	letter-spacing: 0;
}
.box .up .r {
	display: flex;
	justify-content: flex-end;
	align-items: center;
	margin-right: 0;
}
.box .up .r picker {
	margin-left: 16rpx;
}

/* 两根小竖条原为红色方块，与「红＝上涨」的语义冲突。
   改成墨蓝的递增双柱，正好读作一枚微型柱状图字符。 */
.box .up .l .fk {
	width: 4rpx;
	height: 16rpx;
	margin-right: 5rpx;
	border-radius: 6rpx;
	background-color: rgba(0, 93, 153, 0.28);
	flex-shrink: 0;
}
.box .up .l .fk2 {
	width: 4rpx;
	height: 24rpx;
	margin-right: 12rpx;
	border-radius: 6rpx;
	background-color: var(--ink-600);
	flex-shrink: 0;
}

/* 数据来源脚注 */
.tips {
	width: 100%;
	box-sizing: border-box;
	padding: 0 var(--gutter);
	margin-top: 8rpx;
	font-size: var(--fs-caption);
	line-height: 1.5;
	color: var(--text-3);
	text-align: right;
}

/* ---------- 供应链分组卡 ----------
   卡内是全页最密的一段，六个子块并列。按行情终端的读法组织：
   组名退到小字标签、数量升为主角、单位与同比降级，
   同比固定占一列宽度，箭头因此在纵向连成一条通道。 */
.subbox {
	width: 100%;
	box-sizing: border-box;
	margin-bottom: 18rpx;
	background: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: var(--r-md);
	box-shadow: var(--shadow-card);
	overflow: hidden;
}
.subbox:last-child {
	margin-bottom: 0;
}

.tvsgroup-hd {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 20rpx var(--gutter) 14rpx;
	background-color: var(--surface-sunken);
	border-bottom: 1rpx solid var(--hairline);
}

.tvsgroup-title {
	display: flex;
	align-items: center;
	font-size: var(--fs-body-s);
	font-weight: 700;
	color: var(--ink-700);
	letter-spacing: 0.5rpx;
}
.tvsgroup-title::before {
	content: "";
	width: 5rpx;
	height: 22rpx;
	margin-right: 12rpx;
	border-radius: 5rpx;
	flex-shrink: 0;
	background: linear-gradient(180deg, var(--ink-400) 0%, var(--ink-700) 100%);
}

.tvslist {
	padding: 0 var(--gutter);
}

.tvsrow {
	display: flex;
	align-items: center;
	padding: 22rpx 0;
	border-bottom: 1rpx solid var(--hairline);
}

.tvsrow:last-child {
	border-bottom: 0;
}

.tvsrow-name {
	flex: 1;
	min-width: 0;
	font-size: var(--fs-body-s);
	color: var(--text-2);
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.tvsrow-right {
	display: flex;
	align-items: baseline;
	flex-shrink: 0;
}

.tvsrow-qty {
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-title);
	font-weight: 700;
	line-height: 1.1;
	color: var(--ink-700);
}

.tvsrow-unit {
	margin-left: 4rpx;
	font-size: var(--fs-caption);
	color: var(--text-3);
}

/* 同比固定 96rpx 并右对齐，六个子块的箭头因此上下成列 */
.tvsrow-yoy {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	min-width: 96rpx;
	margin-left: 16rpx;
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-caption);
	font-weight: 700;
	color: var(--flat);
}

.tvsrow-yoy.up {
	color: var(--rise);
}

.tvsrow-yoy.down {
	color: var(--fall);
}

/* 整行可点（bindtap="selchage"），行尾补一枚小箭头把这件事说出来 */
.tvsrow::after {
	content: "";
	width: 10rpx;
	height: 10rpx;
	margin-left: 16rpx;
	flex-shrink: 0;
	border-top: 2rpx solid var(--ink-200);
	border-right: 2rpx solid var(--ink-200);
	transform: rotate(45deg);
}

.subarrow {
	width: 14rpx;
	height: auto;
	max-height: 18rpx;
	margin-left: 6rpx;
	flex-shrink: 0;
}

.box .down {
	width: 100%;
	box-sizing: border-box;
	padding: 0 20rpx 16rpx;
	margin-bottom: 0;
}

/* ---------- 卡内并列指标：数字为主角，标签退居其下 ---------- */
.box .down .tjlist {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: stretch;
	margin-bottom: 0;
}
.box .down .tjlist .item {
	flex: 1;
	min-width: 0;
	display: flex;
	justify-content: center;
	align-items: flex-start;
	flex-direction: column;
	padding-right: 20rpx;
	box-sizing: border-box;
}
/* 指标之间用一道发丝线分栏，比单纯留白更利于比对 */
.box .down .tjlist .item + .item {
	padding-left: 28rpx;
	padding-right: 0;
	border-left: 1rpx solid var(--hairline);
}
.box .down .tjlist .item .p1 {
	font-size: var(--fs-body-s);
	color: var(--text-3);
	letter-spacing: 1rpx;
}
.box .down .tjlist .item .p2 {
	display: flex;
	justify-content: flex-start;
	align-items: baseline;
	flex-wrap: wrap;
	margin-bottom: 10rpx;
}
.box .down .tjlist .item .p2 .a1 {
	display: flex;
	justify-content: flex-start;
	align-items: baseline;
	margin-right: 14rpx;
	font-size: var(--fs-body-s);
	color: var(--text-3);
}
.box .down .tjlist .item .p2 .a1 .num {
	margin-right: 6rpx;
	font-size: var(--fs-metric);
	font-weight: 700;
	line-height: 1.1;
	color: var(--ink-700);
}

/* .red 原本在 wxml 里被用于「销售金额」却没有对应样式。
   这里赋予它琥珀色：量为墨蓝、额为琥珀，一眼区分两类指标。 */
.box .down .tjlist .item .p2 .a1.red .num {
	color: var(--signal);
}

/* 同比：做成带底色的小胶囊，涨跌方向比数值本身更先被读到 */
.box .down .tjlist .item .p2 .a2 {
	padding: 2rpx 12rpx;
	border-radius: 999rpx;
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-body-s);
	font-weight: 700;
	color: var(--flat);
	background-color: var(--surface-sunken);
}
.box .down .tjlist .item .p2 .a2.a2_1 {
	color: var(--rise);
	background-color: rgba(210, 64, 41, 0.08);
}
.box .down .tjlist .item .p2 .a2.a2_2 {
	color: var(--fall);
	background-color: rgba(11, 143, 99, 0.08);
}

/* ---------- 表格（继承 app.wxss 的横线体系，此处只补页面语境） ---------- */
.box .down .table {
	border: 0;
	margin-bottom: 24rpx;
}
/* 数据格纵向堆叠：上=本期值（大、墨蓝），下=同比（小、带涨跌色的胶囊），
   两者层级拉开，避免「两个数字挤一行」分不清谁是本期值、谁是同比 */
.box .down .table .td:not(.titletd2) {
	flex-direction: column;
	flex-wrap: nowrap;
	gap: 6rpx;
}
.box .down .table .num {
	margin-right: 0;
	font-size: var(--fs-title);
	font-weight: 700;
	line-height: 1.1;
	color: var(--ink-700);
}
.box .down .table .num2 {
	display: flex;
	justify-content: center;
	align-items: center;
	padding: 2rpx 10rpx;
	border-radius: 999rpx;
	font-size: var(--fs-caption);
	font-weight: 600;
	line-height: 1.4;
	color: var(--text-3);
	background-color: var(--ink-050);
}
.box .down .table .num2.hong {
	color: var(--rise);
	background-color: var(--c-red-soft);
}
.box .down .table .num2.lv {
	color: var(--fall);
	background-color: var(--c-green-soft);
}
.box .down .table .num2 .img {
	width: 14rpx;
	margin-left: 6rpx;
	max-height: 18rpx;
}
.box .down .table .juzhong {
	display: flex;
	justify-content: center;
	align-items: center;
	flex-direction: column;
}

/* 首列可点进详情，用墨蓝字色 + 右侧小箭头把「可点」说清楚。
   注意不要给它 background: transparent —— 那会让第一列跳过 app.wxss 的
   斑马纹，整张表看起来像少了一竖条。 */
.titletd2 {
	justify-content: flex-start;
	padding-left: 12rpx;
	font-size: var(--fs-body-s);
	font-weight: 500;
	color: var(--ink-700);
}
.titletd2::after {
	content: "";
	width: 10rpx;
	height: 10rpx;
	margin-left: 10rpx;
	flex-shrink: 0;
	border-top: 2rpx solid var(--ink-200);
	border-right: 2rpx solid var(--ink-200);
	transform: rotate(45deg);
}

/* 表头留白版：不铺底色，只靠字重与一条略重的下缘线分层，
   这样斑马纹从第一行数据就开始，节奏不被表头打断 */
.box .down .table .tr:first-child .th {
	background-color: var(--surface);
	border-bottom: 1rpx solid var(--hairline-strong);
	color: var(--text-3);
	font-weight: 500;
}
/* 品类表头与首列名称左对齐对齐 */
.titleth {
	justify-content: flex-start;
	padding-left: 12rpx;
}

/* ---------- 图表 ---------- */
ec-canvas {
	width: 100%;
	height: 100%;
}

/* ================= 分组详情：筛选 / 分页 / 图表 / 表格 ================= */
.filter-card,
.chart-card {
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}

.filter-card {
  padding: 18rpx 16rpx;
}

.selector-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.selector-row {
  display: flex;
  gap: 12rpx;
}

.selector-cell {
  display: block;
  min-width: 0;
  flex: 1;
}

.selector-cell-wide {
  width: 100%;
  flex: none;
}

.selector-main {
  width: 100%;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 16rpx 16rpx 14rpx;
  background: var(--surface-sunken);
  border: 1rpx solid var(--hairline-strong);
  border-radius: var(--r-md);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.selector-label {
  font-size: var(--fs-caption);
  font-weight: 500;
  color: var(--text-3);
  letter-spacing: 1rpx;
  line-height: 1;
}

.selector-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

/* 选中值即读数，走等宽数字族，多个筛选器并排时字面宽度一致 */
.selector-value {
  flex: 1;
  min-width: 0;
  font-family: var(--font-num);
  font-variant-numeric: tabular-nums;
  font-size: var(--fs-body);
  color: var(--ink-700);
  font-weight: 700;
  line-height: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.selector-arrow {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

/* 五个分页标签：底色透明贴在纸面上，只留一条发丝基线。
   选中态是全页唯一一处用琥珀的地方——「当前频道」值得那点颜色。 */
.tabbar {
  display: flex;
  align-items: stretch;
  margin: 18rpx 0 16rpx;
  border-bottom: 1rpx solid var(--hairline-strong);
}

.tabitem {
  flex: 1;
  text-align: center;
  font-size: var(--fs-body-s);
  color: var(--text-3);
  letter-spacing: 0.5rpx;
  padding: 18rpx 0 14rpx;
  border-bottom: 4rpx solid transparent;
  transition: color 0.18s ease, border-color 0.18s ease;
}

.tabitem.active {
  color: var(--ink-800);
  font-weight: 700;
  border-bottom-color: var(--signal);
}

.panel {
  display: block;
}

.chart-card {
  padding: 18rpx var(--gutter) 14rpx;
  margin-bottom: 16rpx;
}

/* 卡头：标题带墨条，右侧副标题交代口径（同比/环比…），基线对齐 */
.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.card-title {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 0.5rpx;
}

.card-title::before {
  content: "";
  width: 5rpx;
  height: 24rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  border-radius: 5rpx;
  background: linear-gradient(180deg, var(--ink-400) 0%, var(--ink-700) 100%);
}

.card-sub {
  flex-shrink: 0;
  font-size: var(--fs-caption);
  color: var(--text-3);
}

.chart-frame {
  width: 100%;
  height: 340rpx;
}

.chart-frame-pie {
  height: 320rpx;
}

.chartdom {
  width: 100%;
  height: 100%;
  display: block;
}

/* ---------- 品牌 / 价格段表 ----------
   与 app.wxss 的表格同一套读法：不画竖线、不铺深色表头，
   只靠一条较重的表头基线 + 数据行斑马纹分隔。
   五列的品牌表尤其需要这样——竖线一多，眼睛就找不到行了。 */
.price-table {
  border-radius: var(--r-md);
  overflow: hidden;
}

.price-table-head,
.price-table-row {
  display: flex;
  align-items: stretch;
}

.price-table-head {
  background-color: var(--surface);
  border-bottom: 1rpx solid var(--hairline-strong);
}

.price-table-row {
  border-bottom: 1rpx solid var(--hairline);
}

/* 表头占掉第 1 个子元素，故偶数序号正是第一行数据 —— 与 app.wxss
   的 .tr:nth-child(even) 起点一致，同页两张表的斑马纹才不会错开 */
.price-table-row:nth-child(even) {
  background-color: var(--surface-sunken);
}

.price-table-row:last-child {
  border-bottom: 0;
}

.price-cell {
  box-sizing: border-box;
  padding: 24rpx 10rpx;
  text-align: center;
  font-size: var(--fs-body-s);
  line-height: 1.35;
  color: var(--text-2);
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.price-table-head .price-cell {
  min-height: 68rpx;
  padding: 12rpx 10rpx;
  font-size: var(--fs-caption);
  font-weight: 600;
  color: var(--ink-700);
}

/* 数值列统一等宽字形，市占率 / 均价 / 变化三列纵向自然成列 */
.price-cell-share,
.price-cell-change,
.brand-cell-share,
.brand-cell-change,
.brand-cell-price,
.brand-cell-pricec {
  font-family: var(--font-num);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

.price-table-head .price-cell-share,
.price-table-head .price-cell-change,
.price-table-head .brand-cell-share,
.price-table-head .brand-cell-change,
.price-table-head .brand-cell-price,
.price-table-head .brand-cell-pricec {
  font-family: var(--font-text);
  font-weight: 600;
}

.price-cell-name {
  flex: 1.05;
}

/* 市占率与均价是「水平」而非「变化」，一律墨蓝；
   红色在本项目只留给同比上涨，绝不用来染读数 */
.price-cell-share,
.brand-cell-share,
.brand-cell-price {
  color: var(--ink-700);
}

.price-cell-share {
  flex: 1;
}

.price-cell-change {
  flex: 1.2;
}

.brand-cell-name {
  flex: 1.2;
  justify-content: flex-start;
  text-align: left;
  padding-left: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.brand-cell-share {
  flex: 1;
}

.brand-cell-change {
  flex: 1.15;
}

.brand-cell-price {
  flex: 1.15;
}

.brand-cell-pricec {
  flex: 1.1;
}

/* 变化量：默认灰（含 0 与无数据），只有明确带符号时才上色。
   红涨绿跌，与 .tvsrow-yoy、app.wxss 的 .hong/.lv 保持同一约定。 */
.price-change {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: var(--flat);
}

.price-change.up {
  color: var(--rise);
}

.price-change.down {
  color: var(--fall);
}

.price-arrow {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
}

.divider {
  height: 1rpx;
  background-color: var(--hairline);
  margin: 10rpx 0;
}

/* ---------- AI 摘要 ----------
   它已经嵌在 .chart-card 里，这里不能再来一层白底 + 阴影，
   否则就是卡中卡。只当一个内容容器用。 */
.ai-summary-card {
  padding: 4rpx 0 0;
}

.ai-summary-list {
  display: block;
}

.ai-summary-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.ai-summary-item:last-child {
  border-bottom: 0;
}

/* 四个条目原本是四种几乎分不出差别的蓝，等于没分。
   统一成同一枚墨蓝方章，让字形（↗ ◆ ☷ ▥）自己去区分。 */
.ai-summary-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-invert);
  background: linear-gradient(145deg, var(--ink-400) 0%, var(--ink-700) 100%);
  border-radius: var(--r-sm);
  font-size: var(--fs-title);
  font-weight: 700;
  line-height: 1;
}

/* 只调字号让四个字形视觉重量一致，底色不再各行一变 */
.ai-summary-icon-brand {
  font-size: var(--fs-body-s);
}

.ai-summary-icon-product {
  font-size: var(--fs-heading);
}

.ai-summary-icon-price {
  font-size: var(--fs-title);
}

.ai-summary-content {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  column-gap: 8rpx;
  row-gap: 4rpx;
  line-height: 1.45;
}

.ai-summary-title {
  color: var(--ink-700);
  font-size: var(--fs-body-s);
  font-weight: 700;
}

.ai-summary-text,
.ai-summary-value,
.ai-summary-highlight {
  font-size: var(--fs-body-s);
}

.ai-summary-text {
  color: var(--text-2);
}

/* highlight 承载同比数值，走等宽字形，四行读数左边界自然对齐 */
.ai-summary-value,
.ai-summary-highlight {
  font-weight: 700;
}

.ai-summary-highlight {
  font-family: var(--font-num);
  font-variant-numeric: tabular-nums;
}

/* tone 由 js 给出：rate>0 → up。因此 up 必须是红、down 必须是绿，
   与页内 .tvsrow-yoy / .price-change 一致；此前这里正好写反了。 */
.ai-summary-value.up,
.ai-summary-highlight.up {
  color: var(--rise);
}

.ai-summary-value.down,
.ai-summary-highlight.down {
  color: var(--fall);
}

.ai-summary-value.muted,
.ai-summary-highlight.muted {
  color: var(--flat);
}

/* 数据来源脚注：全页字号最小、色阶最浅的一层 */
.source-note {
  margin: 12rpx 4rpx 0;
  font-size: var(--fs-caption);
  color: var(--text-3);
  line-height: 1.5;
  text-align: center;
}

/* 空态：与脚注区分开，居中留白，不要贴着上一张卡 */
.empty-text {
  padding: 72rpx 0;
  font-size: var(--fs-body-s);
  color: var(--text-3);
  text-align: center;
}
