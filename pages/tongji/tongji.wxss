}
.sellist2 .item .pic{
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
	background-color: #064e7b;
	display: flex;
	justify-content: center;
	align-items: center;
	margin-bottom: 15rpx;
}
.sellist2 .item.hover .pic{
	background-color: #fff;
}
.sellist2 .item .pic image{
	width: 40rpx;
	max-height: 22px;
}
