.sellist2 {
	width: 100%;
	/* height: 87rpx; */
	padding: 40rpx 0;
	padding-bottom: 80rpx;
	box-sizing: border-box;
	display: flex;
	justify-content: space-around;
	align-items: center;
	background-color: #055586;
}

.sellist2 .item {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
}
.sellist2 .item .title{
	font-size: 12px;
	color: rgba(255, 255, 255, 0.3);
}
.sellist2 .item.hover .title {
