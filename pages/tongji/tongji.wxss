/* pages/tongji/tongji.wxss */
page{
	background-color: #f3f3f3;
}
page::before{
  content: '';
  width: 10000vw;
  height: 10000vh;
  z-index: 99999999999999999999;
  position: fixed;
  background-repeat: repeat;
  background-image: url(https://luotu.tianjin8.com/Public/images/logo.png);
  background-size: 250px;
  pointer-events: none;
  transform: rotate(-45deg) translateX(-50%) translateY(-50%);
  transform-origin: top left;
  opacity: .1;
}

.box{
	width: 100%;
	padding: 30rpx 0;
	background-color: #fff;
	border-radius: 6px;
	margin-bottom: 20rpx;
	box-shadow: 0 0 15rpx #ddd;
}
.box .up{
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 35rpx;
}
.box .up2{
	align-items: flex-end;
}
.box .up3{
	box-sizing: border-box;
	padding-left: 25rpx;
	margin-bottom: 0;
}
.box .up4{
	box-sizing: border-box;
	padding-left: 25rpx;
}
.box .up .l{
	display: flex;
	justify-content: flex-start;
	align-items: center;
}
.box .up .l2{
	margin-left: 25rpx;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	justify-content: flex-start;
}
.box .up .l2 .select{
	margin-bottom: 20rpx;
}
.box .up .l2 .select:last-child{
	margin-bottom: 0;
}
.box .up .l2 .select .picker{
	box-sizing: border-box;
	border:1rpx solid #055586;
	min-width: 240rpx;
	height: 45rpx;
	font-size: 12px;
	color: #333;
	padding-left: 10rpx;
	display: flex;
	align-items: center;
	justify-content: space-between;
}
.box .up .l2 .select .picker .sanjiao{
	margin-right: 15rpx;
	width: 15rpx;
}
.box .up .l .fk{
	width: 6rpx;
	height: 15rpx;
	background-color: #ca3828;
	margin-right: 5rpx;
	border-radius: 10rpx;
}
.box .up .l .fk2{
	width: 6rpx;
	height: 20rpx;
	background-color: #ca3828;
	margin-right: 15rpx;
	border-radius: 10rpx;
}
.box .up .l .title{
	font-size: 16px;
	color: #333;
}
.box .up .r{
	display: flex;
	justify-content: flex-end;
	align-items: center;
	margin-right: 25rpx;
}
.box .up .r picker{
	margin-left: 35rpx;
}
.box .up .r .picker{
	display: flex;
	align-items: center;
	font-size: 14px;
	color: #888;
}
.box .up .r .picker .sj{
	width: 13rpx;
	margin-left: 10rpx;
	max-height: 4px;
}
.box .up .r .item{
	width: 80rpx;
	height: 35rpx;
	box-sizing: border-box;
	display: flex;
	justify-content: center;
	align-items: center;
	color: #2489f0;
	border:1px solid #2489f0;
	background-color: #fff;
	font-size: 11px;
}
.box .up .r .item.hover{
	background-color: #2489f0;
	color: #fff;
}
.box .up .r .item:first-child{
	border-radius: 3px 0 0 3px;
}
.box .up .r .item:last-child{
	border-radius: 0 3px 3px 0;
	margin-right: 25rpx;
}
.tips{
	width: 100%;
	font-size: 12px;
	color: #9999ac;
	padding: 0 25rpx;
	box-sizing: border-box;
	text-align: right;
}
.box .down{
	width: 100%;
	padding: 0 25rpx;
	box-sizing: border-box;
	margin-bottom: 15rpx;
}
.box .down .tjlist{
	width: 100%;
	display: flex;
	justify-content: space-around;
	align-items: stretch;
	margin-bottom: 35rpx;
}
.box .down .tjlist .item{
	/* width: 50%; */
	display: flex;
	justify-content: center;
	align-items: flex-start;
	flex-direction: column;
	align-content: stretch;
}
.box .down .tjlist .item .p1{
	font-size: 12px;
	color: #888;
	
}
.box .down .tjlist .item .p2{
	display: flex;
	justify-content: flex-start;
	align-items: flex-end;
	margin-bottom: 10rpx;
}
.box .down .tjlist .item .p2 .a1{
	display: flex;
	justify-content: flex-start;
	align-items: flex-end;
	font-size: 14px;
	color: #055586;
	margin-right: 15rpx;
}
.box .down .tjlist .item .p2 .a1 .num{
	font-size: 18px;
	color: #055586;
	font-weight: bold;
	line-height: 20px;
}
.box .down .tjlist .item .p2 .a2{
	font-size: 14px;
	/* color: #fb474f; */
}
.box .down .tjlist .item .p2 .a2.a2_1{
  color: #fb474f;
}
.box .down .tjlist .item .p2 .a2.a2_2{
  color: #29c384;
}
.box .down .table .num{
	font-size: 16px;
	color: #055586;
	margin-right: 10rpx;
	font-weight: bold;
}
.box .down .table .num2{
	font-size: 10px;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-weight: bold;
}

.box .down .table .num2 .img{
	width: 15rpx;
	margin-left: 10rpx;
	max-height: 11px;
}
.box .down .table .num3{
	font-size: 8px;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-weight: bold;
}
.box .down .table .juzhong{
	display: flex;
	justify-content: center;
	align-items: center;
	flex-direction: column;
}
