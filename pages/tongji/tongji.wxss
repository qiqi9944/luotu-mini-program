/* pages/tongji/tongji.wxss — 数据页：行情终端式的指标与表格 */
page {
	background-color: var(--paper);
}

/* 版权水印。原实现用 10000vw × 10000vh 的图层配合 20 位数的 z-index，
   合成层面积巨大且 z-index 早已溢出被钳制；这里收敛到可控尺寸与量级，
   视觉效果不变，滚动时的合成开销大幅下降。 */
page::before {
	content: "";
	position: fixed;
	left: 50%;
	top: 50%;
	width: 280vw;
	height: 280vh;
	z-index: 999;
	pointer-events: none;
	opacity: 0.05;
	background-image: url(https://luotu.tianjin8.com/Public/images/logo.png);
	background-repeat: repeat;
	background-size: 250px;
	transform: translate(-50%, -50%) rotate(-45deg);
}

/* ---------- 顶部品类切换带（横向滑动：总览 + 动态品类组） ---------- */
.sellist2 {
	position: relative;
	width: 100%;
	box-sizing: border-box;
	display: block;
	white-space: nowrap;
	background: linear-gradient(160deg, var(--ink-700) 0%, var(--ink-900) 100%);
}
.sellist2 .navrow {
	position: relative;
	z-index: 1;
	display: flex;
	align-items: flex-start;
	padding: 44rpx 12rpx 100rpx;
	box-sizing: border-box;
}
.sellist2::before {
	content: "";
	position: absolute;
	left: -20%;
	top: -60%;
	width: 140%;
	height: 260%;
	pointer-events: none;
	background-image: repeating-linear-gradient(
			45deg,
			rgba(255, 255, 255, 0.045) 0 1rpx,
			transparent 1rpx 24rpx
		),
		repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.03) 0 1rpx, transparent 1rpx 24rpx);
}

.sellist2::after {
	content: "";
	position: absolute;
	right: -80rpx;
	top: -140rpx;
	width: 420rpx;
	height: 420rpx;
	border-radius: 50%;
	pointer-events: none;
	background: radial-gradient(circle, rgba(46, 134, 184, 0.42) 0%, rgba(46, 134, 184, 0) 70%);
}

.sellist2 .item {
	position: relative;
	z-index: 1;
	flex: none;
	width: 176rpx;
	display: flex;
	flex-direction: column;
	justify-content: flex-start;
	align-items: center;
}
.sellist2 .item .title {
	padding: 0 6rpx;
	text-align: center;
	font-size: var(--fs-body-s);
	line-height: 1.3;
	/* 原 rgba(255,255,255,.3) 在深蓝上仅约 1.5:1，属于不可读；提到 .62 */
	color: rgba(255, 255, 255, 0.62);
	transition: color 0.2s ease;
}
.sellist2 .item.hover .title {
	color: var(--text-invert);
	font-weight: 600;
}
.sellist2 .item .pic {
	width: 84rpx;
	height: 84rpx;
	border-radius: 50%;
	box-sizing: border-box;
	background-color: rgba(255, 255, 255, 0.1);
	border: 1rpx solid rgba(255, 255, 255, 0.16);
	display: flex;
	justify-content: center;
	align-items: center;
	margin-bottom: 16rpx;
	transition: background-color 0.2s ease, box-shadow 0.2s ease;
}
/* 首字母底色：直接取设计令牌的标准分类色板（与产品结构饼图同源），
   主色 → 压暗 -ink 做渐变，循环取色（index % 9），相邻品类色相尽量拉开。
   注意这几条必须写在 .item.hover .pic 之前——两者选择器权重相同，
   靠书写顺序定胜负，否则选中态的白底会被渐变盖掉。 */
.sellist2 .item .pic.icon-all {
	background: linear-gradient(145deg, #7fb2cf 0%, #3d7b9e 100%);
	border-color: transparent;
}
.sellist2 .item .pic.icon-c0 {
	background: linear-gradient(145deg, var(--c-blue) 0%, var(--c-blue-ink) 100%);
	border-color: transparent;
}
.sellist2 .item .pic.icon-c1 {
	background: linear-gradient(145deg, var(--c-red) 0%, var(--c-red-ink) 100%);
	border-color: transparent;
}
.sellist2 .item .pic.icon-c2 {
	background: linear-gradient(145deg, var(--c-green) 0%, var(--c-green-ink) 100%);
	border-color: transparent;
}
.sellist2 .item .pic.icon-c3 {
	background: linear-gradient(145deg, var(--c-orange) 0%, var(--c-orange-ink) 100%);
	border-color: transparent;
}
.sellist2 .item .pic.icon-c4 {
	background: linear-gradient(145deg, var(--c-violet) 0%, var(--c-violet-ink) 100%);
	border-color: transparent;
}
.sellist2 .item .pic.icon-c5 {
	background: linear-gradient(145deg, var(--c-cyan) 0%, var(--c-cyan-ink) 100%);
	border-color: transparent;
}
.sellist2 .item .pic.icon-c6 {
	background: linear-gradient(145deg, var(--c-amber) 0%, var(--c-amber-ink) 100%);
	border-color: transparent;
}
.sellist2 .item .pic.icon-c7 {
	background: linear-gradient(145deg, var(--c-indigo) 0%, var(--c-indigo-ink) 100%);
	border-color: transparent;
}
.sellist2 .item .pic.icon-c8 {
	background: linear-gradient(145deg, var(--c-magenta) 0%, var(--c-magenta-ink) 100%);
	border-color: transparent;
}

/* 选中态：白底 + 一圈外发光，在深色带上形成明确的焦点 */
.sellist2 .item.hover .pic {
	background: var(--surface);
	border-color: var(--surface);
	box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.14);
}
/* 选中后底色转白，字必须跟着转墨蓝，否则白底白字 */
.sellist2 .item.hover .pic .icon-letter {
	color: var(--ink-700);
}
.sellist2 .item .pic image {
	width: 40rpx;
	max-height: 44rpx;
}
.sellist2 .item .pic .icon-letter {
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--text-invert);
	font-size: var(--fs-heading);
	font-weight: 700;
	line-height: 1;
	transition: color 0.2s ease;
}

/* ---------- 顶部导航图标：复用首页那套线性图标（mask 上色） ----------
   深色带上默认白色，选中态底色转白后图标随之转墨蓝。 */
.sellist2 .svg-icon {
	width: 48rpx;
	height: 48rpx;
	background-color: rgba(255, 255, 255, 0.92);
	-webkit-mask-repeat: no-repeat;
	-webkit-mask-position: center;
	-webkit-mask-size: contain;
	mask-repeat: no-repeat;
	mask-position: center;
	mask-size: contain;
	transition: background-color 0.2s ease;
}
.sellist2 .item.hover .pic .svg-icon {
	background-color: var(--ink-700);
}
