<!--pages/yanbao/redian.wxml-->
<view class="sellist">
	<view class="item {{pagetype==1?'hover':''}}" data-type='1' bindtap="nextpage">热点</view>
	<view class="item {{pagetype==2?'hover':''}}" data-type='2' bindtap="nextpage">报告</view>
	<view class="item {{pagetype==3?'hover':''}}" data-type='3' bindtap="nextpage">活动</view>
</view>
<view class="con">
	<view class="page-section page-section-spacing swiper">
		<swiper indicator-dots="{{indicatorDots}}" autoplay="{{autoplay}}" interval="{{interval}}" duration="{{duration}}" indicator-color="{{indicatorColor}}" indicator-active-color="{{indicatorActiveColor}}">
			<block wx:for="{{banner}}" wx:key="*this">
				<swiper-item>
					<view class="swiper-item">
						<navigator url="{{item.url}}" class="swiper-item {{index}}">
							<image src="{{item.pic}}" mode="widthFix" class="pic"></image>
						</navigator>
					</view>
				</swiper-item>
			</block>
		</swiper>
	</view>
	<view class="redian" wx:if="{{pagetype==1}}">
		<view class="newsbox">
			<view class="main">
				<view class="down">
					<block wx:for="{{newslist}}" wx:key="id">
						<navigator url="./view?id={{item.id}}" class="item">
							<view class="l">
								<view class="shang">
									<view class="title">
										<image src="/pages/images/liststyle2.png" mode="widthFix" class="pic"></image>{{item.name}}
									</view>
								</view>
								<view class="xia">{{item.addtime}}</view>
							</view>
							<image src="{{item.pic}}" mode="widthFix" wx:if="{{item.pic}}" class="r"></image>
						</navigator>
					</block>
					<view class="more" wx:if="{{!lastpage}}" bindtap="getnews">查看更多></view>
				</view>
			</view>
		</view>
	</view>
	<view class="yanbao" wx:if="{{pagetype==2}}">
		<view class="newsbox" wx:if="{{yuebao.length}}">
			<view class="main">
				<view class="up">
					<view class="title">洛图<view class="sp">月</view>报</view>
					<navigator url="/pages/yanbao/list?type=3" class="more">
						<image src="/pages/images/dian.png" mode="widthFix"></image>
					</navigator>
				</view>
				<view class="down">
					<block wx:for="{{yuebao}}" wx:key="id">
						<navigator url="./view?id={{item.id}}" class="item">
							<view class="shang">
								<image src="/pages/images/liststyle.png" mode="widthFix" class="pic"></image>
								<view class="title">{{item.name}}</view>
							</view>
							<view class="xia">{{item.addtime}}</view>
						</navigator>
					</block>
				</view>
			</view>
		</view>
		<view class="newsbox" wx:if="{{jibao.length}}">
			<view class="main">
				<view class="up">
					<view class="title">洛图<view class="sp">季</view>报</view>
					<navigator url="/pages/yanbao/list?type=4" class="more">
						<image src="/pages/images/dian.png" mode="widthFix"></image>
					</navigator>
				</view>
				<view class="down">
					<block wx:for="{{jibao}}" wx:key="id">
						<navigator url="./view?id={{item.id}}" class="item">
							<view class="shang">
								<image src="/pages/images/liststyle.png" mode="widthFix" class="pic"></image>
								<view class="title">{{item.name}}</view>
							</view>
							<view class="xia">{{item.addtime}}</view>
						</navigator>
					</block>
				</view>
			</view>
		</view>
		<view class="newsbox" wx:if="{{nianbao.length}}">
			<view class="main">
				<view class="up">
					<view class="title">洛图<view class="sp">年</view>报</view>
					<navigator url="/pages/yanbao/list?type=5" class="more">
						<image src="/pages/images/dian.png" mode="widthFix"></image>
					</navigator>
				</view>
				<view class="down">
					<block wx:for="{{nianbao}}" wx:key="id">
						<navigator url="./view?id={{item.id}}" class="item">
							<view class="shang">
								<image src="/pages/images/liststyle.png" mode="widthFix" class="pic"></image>
								<view class="title">{{item.name}}</view>
							</view>
							<view class="xia">{{item.addtime}}</view>
						</navigator>
					</block>
				</view>
			</view>
		</view>
	</view>
	<view class="redian" wx:if="{{pagetype==3}}">
		<view class="newsbox">
			<view class="main">
				<view class="down">
					<block wx:for="{{newslist2}}" wx:key="id">
						<navigator url="./view?id={{item.id}}" class="item">
							<view class="l">
								<view class="shang">
									<view class="title">
										<image src="/pages/images/liststyle2.png" mode="widthFix" class="pic"></image>{{item.name}}
									</view>
								</view>
								<view class="xia">{{item.addtime}}</view>
							</view>
							<image src="{{item.pic}}" mode="widthFix" wx:if="{{item.pic}}" class="r"></image>
						</navigator>
					</block>
					<view class="more" wx:if="{{!lastpage2}}" bindtap="getnews3">查看更多></view>
				</view>
			</view>
		</view>
	</view>
</view>