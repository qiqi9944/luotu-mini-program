<!--pages/yanbao/redian.wxml-->
<view class="redian-page">
	<view class="top-area">
		<view class="searchbar">
			<image src="/pages/images/fdj.png" mode="widthFix" class="search-icon" bindtap="search"></image>
			<input class="search-input"
				type="text"
				placeholder="搜索"
				placeholder-class="search-placeholder"
				data-name="keywords"
				value="{{keywords}}"
				bindinput="inputchange"
				bindconfirm="search"
				confirm-type="search" />
		</view>
		<view class="sellist">
			<view class="item {{currentTab==1?'hover':''}}" data-type="1" bindtap="nextpage">
				<text>行业分析</text>
				<view class="underline"></view>
			</view>
			<view class="item {{currentTab==2?'hover':''}}" data-type="2" bindtap="nextpage">
				<text>报告专区</text>
				<view class="underline"></view>
			</view>
			<view class="item {{currentTab==3?'hover':''}}" data-type="3" bindtap="nextpage">
				<text>小视频</text>
				<view class="underline"></view>
			</view>
			<view class="item {{currentTab==4?'hover':''}}" data-type="4" bindtap="nextpage">
				<text>活动</text>
				<view class="underline"></view>
			</view>
		</view>
	</view>
	<view class="con">
	<view class="redian" wx:if="{{pagetype==1}}">
		<view class="newsbox">
			<view class="main">
				<view class="down">
					<block wx:for="{{newslist}}" wx:key="id">
						<navigator url="/pkg-research/yanbao/view?id={{item.id}}" class="item" hover-class="tap-row">
							<view class="l">
								<view class="shang">
									<view class="title">
										<image src="/pages/images/liststyle2.png" mode="widthFix" class="pic"></image>{{item.name}}
									</view>
								</view>
								<view class="xia">{{item.addtime}}</view>
							</view>
							<image src="{{item.pic}}" mode="widthFix" wx:if="{{item.pic}}" class="r"></image>
						</navigator>
					</block>
					<view class="more" wx:if="{{!lastpage}}" bindtap="getnews">查看更多></view>
				</view>
			</view>
		</view>
	</view>
	<view class="yanbao" wx:if="{{pagetype==2}}">
		<view class="newsbox" wx:if="{{yuebao.length}}">
			<view class="main">
				<view class="up">
					<view class="title">洛图<view class="sp">月</view>报</view>
					<navigator url="/pkg-research/yanbao/list?type=3" class="more">
						<image src="/pages/images/dian.png" mode="widthFix"></image>
					</navigator>
				</view>
				<view class="down">
					<block wx:for="{{yuebao}}" wx:key="id">
						<navigator url="/pkg-research/yanbao/view?id={{item.id}}" class="item" hover-class="tap-row">
							<view class="shang">
								<image src="/pages/images/liststyle.png" mode="widthFix" class="pic"></image>
								<view class="title">{{item.name}}</view>
							</view>
							<view class="xia">{{item.addtime}}</view>
						</navigator>
					</block>
				</view>
			</view>
		</view>
		<view class="newsbox" wx:if="{{jibao.length}}">
			<view class="main">
				<view class="up">
					<view class="title">洛图<view class="sp">季</view>报</view>
					<navigator url="/pkg-research/yanbao/list?type=4" class="more">
						<image src="/pages/images/dian.png" mode="widthFix"></image>
					</navigator>
				</view>
				<view class="down">
					<block wx:for="{{jibao}}" wx:key="id">
						<navigator url="/pkg-research/yanbao/view?id={{item.id}}" class="item" hover-class="tap-row">
							<view class="shang">
								<image src="/pages/images/liststyle.png" mode="widthFix" class="pic"></image>
								<view class="title">{{item.name}}</view>
							</view>
							<view class="xia">{{item.addtime}}</view>
						</navigator>
					</block>
				</view>
			</view>
		</view>
		<view class="newsbox" wx:if="{{nianbao.length}}">
			<view class="main">
				<view class="up">
					<view class="title">洛图<view class="sp">年</view>报</view>
					<navigator url="/pkg-research/yanbao/list?type=5" class="more">
						<image src="/pages/images/dian.png" mode="widthFix"></image>
					</navigator>
				</view>
				<view class="down">
					<block wx:for="{{nianbao}}" wx:key="id">
						<navigator url="/pkg-research/yanbao/view?id={{item.id}}" class="item" hover-class="tap-row">
							<view class="shang">
								<image src="/pages/images/liststyle.png" mode="widthFix" class="pic"></image>
								<view class="title">{{item.name}}</view>
							</view>
							<view class="xia">{{item.addtime}}</view>
						</navigator>
					</block>
				</view>
			</view>
		</view>
	</view>
	<view class="redian" wx:if="{{pagetype==3}}">
		<block wx:for="{{videoGroups}}" wx:key="id" wx:for-item="group">
		<view class="video-group" wx:if="{{group.videos.length}}">
			<view class="video-group-head">
				<view class="video-group-bar"></view>
				<view class="video-group-name">{{group.name}}</view>
			</view>
			<view class="video-grid">
				<view class="video-card" wx:for="{{group.videos}}" wx:key="id" data-url="{{item.url}}" data-feedid="{{item.feed_id}}" data-feedtoken="{{item.feed_token}}" data-finder="{{item.finder_user_name}}" data-id="{{item.id}}" bindtap="playVideo" hover-class="tap-card">
					<view class="video-cover">
						<channel-video wx:if="{{item.feed_id}}" class="video-pic" feed-id="{{item.feed_id}}" finder-user-name="{{item.finder_user_name}}" object-fit="cover"></channel-video>
						<channel-video wx:elif="{{item.feed_token}}" class="video-pic" feed-token="{{item.feed_token}}" object-fit="cover"></channel-video>
						<video wx:elif="{{item.url}}" class="video-pic" src="{{item.url}}" object-fit="cover" controls="{{true}}"></video>
						<image wx:elif="{{item.pic}}" class="video-pic" src="{{item.pic}}" mode="aspectFill"></image>
						<view wx:else class="video-pic video-pic--ph"><view class="video-play-badge"></view></view>
					</view>
					<view class="video-body">
						<view class="video-title">{{item.name || '洛图视频'}}</view>
						<view class="video-desc" wx:if="{{item.description}}">{{item.description}}</view>
					</view>
				</view>
			</view>
		</view>
		</block>
		<view class="video-empty" wx:if="{{!videolist.length}}">
			<text>暂无视频</text>
		</view>
	</view>
	<view class="redian" wx:if="{{pagetype==4}}">
		<block wx:for="{{activityGroups}}" wx:key="id" wx:for-item="group">
		<view class="video-group" wx:if="{{group.banners.length || group.list.length}}">
			<view class="video-group-head">
				<view class="video-group-bar"></view>
				<view class="video-group-name">{{group.name}}</view>
			</view>
			<view class="activity-list" wx:if="{{group.banners.length}}">
				<block wx:for="{{group.banners}}" wx:key="id">
					<navigator url="/pkg-research/yanbao/view?id={{item.id}}" class="activity-banner" hover-class="tap-dim" hover-stay-time="80">
						<image wx:if="{{item.bannerpic || item.pic}}" src="{{item.bannerpic || item.pic}}" mode="widthFix" class="activity-banner-img" data-id="{{item.id}}" binderror="bannerImgError"></image>
						<view wx:else class="activity-banner-fallback">
							<view class="activity-banner-title">{{item.name}}</view>
							<view class="activity-banner-date">{{item.addtime}}</view>
						</view>
					</navigator>
				</block>
			</view>
			<view class="newsbox" wx:if="{{group.list.length}}">
				<view class="main">
					<view class="down">
						<block wx:for="{{group.list}}" wx:key="id">
							<navigator url="/pkg-research/yanbao/view?id={{item.id}}" class="item" hover-class="tap-row">
								<view class="l">
									<view class="shang">
										<view class="title">
											<image src="/pages/images/liststyle2.png" mode="widthFix" class="pic"></image>{{item.name}}
										</view>
									</view>
									<view class="xia">{{item.addtime}}</view>
								</view>
								<image src="{{item.pic}}" mode="widthFix" wx:if="{{item.pic}}" class="r"></image>
							</navigator>
						</block>
					</view>
				</view>
			</view>
		</view>
		</block>
		<view class="video-empty" wx:if="{{!newslist2.length}}">
			<text>暂无活动</text>
		</view>
	</view>
	<view class="video-mask" wx:if="{{showVideoMask}}">
		<swiper class="video-swiper" vertical="{{true}}" current="{{videoCurrent}}" duration="300" bindchange="onVideoChange">
			<swiper-item wx:for="{{playList}}" wx:key="id" wx:for-item="item" wx:for-index="idx">
				<view class="video-swiper-item">
					<video wx:if="{{item.url}}" src="{{item.url}}" class="video-player" autoplay="{{idx == videoCurrent}}" controls object-fit="contain"></video>
					<view class="video-swiper-meta">
						<view class="video-swiper-title">{{item.name || '洛图视频'}}</view>
						<view class="video-swiper-desc" wx:if="{{item.description}}">{{item.description}}</view>
					</view>
				</view>
			</swiper-item>
		</swiper>
		<view class="video-close" catchtap="closeVideo">✕</view>
		<view class="video-countnum" wx:if="{{playList.length > 1}}"><text>{{videoCurrent + 1}}/{{playList.length}}</text></view>
	</view>
	<view class="safe-bottom"></view>
</view>
</view>
