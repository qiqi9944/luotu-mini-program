/* pages/yanbao/redian.wxss — 观研页：浅蓝页眉（搜索 + 分栏）→ 纸面浮起 → 报告列表 */
.redian-page {
	min-height: 100%;
	background: var(--paper);
}

/* 顶部区域使用统一浅蓝页眉，搜索与分栏自然连成一片。 */
.top-area {
	position: relative;
	box-sizing: border-box;
	padding: 24rpx var(--gutter) 0;
	overflow: hidden;
	background: var(--header-bg);
}
.top-area::before {
	content: "";
	position: absolute;
	left: -20%;
	top: -60%;
	width: 140%;
	height: 260%;
	pointer-events: none;
	background-image: repeating-linear-gradient(
			45deg,
			rgba(5, 85, 134, 0.045) 0 1rpx,
			transparent 1rpx 24rpx
		),
		repeating-linear-gradient(-45deg, rgba(5, 85, 134, 0.03) 0 1rpx, transparent 1rpx 24rpx);
}
.top-area::after {
	content: "";
	position: absolute;
	right: -80rpx;
	top: -160rpx;
	width: 420rpx;
	height: 420rpx;
	border-radius: 50%;
	pointer-events: none;
	background: radial-gradient(circle, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0) 70%);
}

/* ---------- 浅蓝页眉上的搜索框 ---------- */
.searchbar {
	position: relative;
	z-index: 1;
	width: 100%;
	height: 84rpx;
	padding: 0 28rpx;
	box-sizing: border-box;
	display: flex;
	align-items: center;
	background: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: 999rpx;
}
.search-icon {
	width: 32rpx;
	margin-right: 18rpx;
	flex-shrink: 0;
	opacity: 0.85;
}
.search-input {
	flex: 1;
	height: 100%;
	font-size: var(--fs-body);
	color: var(--text-1);
}
.search-placeholder {
	color: var(--text-3);
	font-size: var(--fs-body);
}

/* ---------- 四栏切换：琥珀色下划线作为唯一的选中标记 ---------- */
.sellist {
	position: relative;
	z-index: 1;
	width: 100%;
	padding: 32rpx 0 24rpx;
	box-sizing: border-box;
	display: flex;
	justify-content: space-between;
	align-items: flex-end;
	background: transparent;
	overflow: visible;
}
/* 深色带已自带纹理，此处不再叠加 */
.sellist::before,
.sellist::after {
	display: none;
}

.sellist .item {
	width: 25%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: flex-start;
	line-height: 1;
	box-sizing: border-box;
	color: var(--text-2);
	transition: color 0.2s ease;
}
.sellist .item text {
	font-size: var(--fs-body);
	line-height: 1.2;
	letter-spacing: 1rpx;
}
.sellist .item .underline {
	width: 44rpx;
	height: 5rpx;
	margin-top: 16rpx;
	border-radius: 999rpx;
	background: transparent;
	transition: background-color 0.2s ease, width 0.2s ease;
}
.sellist .item.hover {
	color: var(--ink-700);
	font-weight: 600;
}
.sellist .item.hover .underline {
	width: 56rpx;
	background: var(--signal);
}

/* ---------- 内容纸面 ---------- */
.con {
	position: relative;
	z-index: 99;
	box-sizing: border-box;
	padding: 30rpx var(--gutter) 32rpx;
	margin-top: 0;
	background-color: var(--paper);
	border-radius: var(--r-sheet) var(--r-sheet) 0 0;
	border-top: 1rpx solid rgba(255, 255, 255, 0.5);
	box-shadow: 0 -8rpx 24rpx rgba(5, 85, 134, 0.06);
}

/* ---------- 资讯 / 视频 / 活动列表 ---------- */
.redian .newsbox {
	width: 100%;
	box-sizing: border-box;
	padding: 4rpx 24rpx;
	margin-bottom: 24rpx;
	background-color: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: var(--r-lg);
	box-shadow: var(--shadow-card);
}
.redian .newsbox .down {
	width: 100%;
}
.redian .newsbox .down .item {
	width: 100%;
	padding: 28rpx 0;
	border-bottom: 1rpx solid var(--hairline);
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
}
.redian .newsbox .down .item:last-child {
	border-bottom: 0;
}
.redian .newsbox .down .item .l {
	flex: 1;
	min-width: 0;
}
.redian .newsbox .down .item .r {
	width: 176rpx;
	height: auto;
	margin-left: 24rpx;
	flex-shrink: 0;
	border-radius: var(--r-sm);
	background-color: var(--surface-sunken);
}
.redian .newsbox .down .item .shang {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	margin-bottom: 14rpx;
}
/* 资讯行的小圆点图标写在 .title 内部，而 .title 是 -webkit-box 纵向盒，
   图标会被当成第一个盒子压在标题上方（原本就存在的错位）。
   这里隐藏该图片，改用 .shang::before 画一枚方形标记，不再干扰行夹断。 */
.redian .newsbox .down .item .shang .title .pic {
	display: none;
}
.redian .newsbox .down .item .shang::before {
	content: "";
	width: 12rpx;
	height: 12rpx;
	margin-right: 16rpx;
	margin-top: 16rpx;
	flex-shrink: 0;
	border-radius: 2rpx;
	background-color: var(--ink-400);
	transform: rotate(45deg);
}
.redian .newsbox .down .item .shang .title {
	flex: 1;
	min-width: 0;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
	font-size: var(--fs-body);
	line-height: 1.45;
	color: var(--text-1);
}

.redian .newsbox .down .item .xia {
	width: 100%;
	box-sizing: border-box;
	padding-left: 28rpx;
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-caption);
	letter-spacing: 0.5rpx;
	color: var(--text-3);
}

/* 「查看更多」：加一道上分隔线，读作列表的收口而非孤立文字 */
.redian .newsbox .more {
	width: 100%;
	height: 96rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	border-top: 1rpx solid var(--hairline);
	font-size: var(--fs-body-s);
	letter-spacing: 2rpx;
	color: var(--ink-600);
}

/* ---------- 洛图月报 / 季报 / 年报 ---------- */
.yanbao .newsbox {
	width: 100%;
	box-sizing: border-box;
	padding: 30rpx 24rpx 4rpx;
	margin-bottom: 24rpx;
	background-color: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: var(--r-lg);
	box-shadow: var(--shadow-card);
}
.yanbao .newsbox .up {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding-bottom: 22rpx;
	border-bottom: 1rpx solid var(--hairline);
}
.yanbao .newsbox .up .title {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-size: var(--fs-title);
	font-weight: 600;
	color: var(--text-1);
	letter-spacing: 1rpx;
}

/* 「月/季/年」字符徽标：原来 padding+50% 圆角会拉成椭圆，
   且用了与「上涨」同族的红色；改成固定尺寸的墨蓝正圆。 */
.yanbao .newsbox .up .title .sp {
	width: 40rpx;
	height: 40rpx;
	margin: 0 6rpx;
	padding: 0;
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 50%;
	background: linear-gradient(145deg, var(--ink-400) 0%, var(--ink-700) 100%);
	color: var(--text-invert);
	font-size: var(--fs-body-s);
	font-weight: 600;
}
.yanbao .newsbox .up .more {
	width: 40rpx;
	height: 40rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	flex-shrink: 0;
}
.yanbao .newsbox .up .more image {
	width: 30rpx;
	max-height: 12rpx;
	opacity: 0.5;
}

.yanbao .newsbox .down {
	width: 100%;
}
.yanbao .newsbox .down .item {
	width: 100%;
	padding: 26rpx 0;
	border-bottom: 1rpx solid var(--hairline);
}
.yanbao .newsbox .down .item:last-child {
	border-bottom: 0;
}
.yanbao .newsbox .down .item .shang {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	margin-bottom: 12rpx;
}

.yanbao .newsbox .down .item .shang .pic {
	width: 22rpx;
	margin-right: 14rpx;
	max-height: 22rpx;
	flex-shrink: 0;
	opacity: 0.55;
}
.yanbao .newsbox .down .item .shang .title {
	flex: 1;
	min-width: 0;
	white-space: nowrap;
	text-overflow: ellipsis;
	overflow: hidden;
	font-size: var(--fs-body);
	color: var(--text-1);
}
.yanbao .newsbox .down .item .xia {
	width: 100%;
	box-sizing: border-box;
	padding-left: 36rpx;
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-caption);
	letter-spacing: 0.5rpx;
	color: var(--text-3);
}

/* ---------- 观研-小视频：两列卡片 ---------- */
.video-grid {
	width: 100%;
	display: flex;
	flex-wrap: wrap;
	justify-content: space-between;
	padding: 4rpx 0 0;
}
.video-grid .video-card {
	width: calc(50% - 10rpx);
	margin-bottom: 30rpx;
	background-color: #ffffff;
	border-radius: 24rpx;
	box-shadow: 0 2rpx 8rpx rgba(3, 37, 60, 0.04), 0 12rpx 30rpx rgba(3, 37, 60, 0.05);
	overflow: hidden;
	box-sizing: border-box;
}
.video-grid .video-cover {
	position: relative;
	width: 100%;
	height: 220rpx;
	background-color: #dfe8ee;
	overflow: hidden;
}
.video-grid .video-cover .video-pic {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}
.video-grid .video-pic--ph {
	background: linear-gradient(150deg, #7acbff 0%, #055586 100%);
}
.video-grid .video-pic--ph::before {
	content: "";
	position: absolute;
	left: -30%;
	top: -60%;
	width: 160%;
	height: 220%;
	background-image: repeating-linear-gradient(
			45deg,
			rgba(255, 255, 255, 0.06) 0 1rpx,
			transparent 1rpx 26rpx
		),
		repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.04) 0 1rpx, transparent 1rpx 26rpx);
}
.video-grid .video-play-badge {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 76rpx;
	height: 76rpx;
	margin: -38rpx 0 0 -38rpx;
	box-sizing: border-box;
	border-radius: 50%;
	border: 2rpx solid rgba(255, 255, 255, 0.66);
	background: rgba(21, 101, 179, 0.42);
	display: flex;
	justify-content: center;
	align-items: center;
	z-index: 2;
}
.video-grid .video-play-badge::after {
	content: "";
	width: 0;
	height: 0;
	margin-left: 6rpx;
	border-left: 22rpx solid #ffffff;
	border-top: 13rpx solid transparent;
	border-bottom: 13rpx solid transparent;
}
.video-grid .video-body {
	padding: 18rpx 20rpx 24rpx;
}
.video-grid .video-title {
	font-size: 28rpx;
	font-weight: 600;
	line-height: 1.4;
	color: #12212b;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
}
.video-grid .video-desc {
	margin-top: 8rpx;
	font-size: 22rpx;
	line-height: 1.5;
	color: #8698a5;
	white-space: pre-line;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
}
.video-grid .video-empty {
	width: 100%;
	padding: 120rpx 0;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 24rpx;
	color: #8698a5;
}

/* ---------- 活动专区：整张 banner 长图，去掉标题+小图的行式列表 ---------- */
.activity-list {
	width: 100%;
}
.activity-banner {
	display: block;
	width: 100%;
	margin-bottom: 28rpx;
	border-radius: var(--r-md);
	overflow: hidden;
	box-shadow: var(--shadow-card);
	background-color: var(--surface-sunken);
}
.activity-banner-img {
	display: block;
	width: 100%;
	border-radius: var(--r-md);
}
.activity-banner-fallback {
	width: 100%;
	box-sizing: border-box;
	padding: 88rpx 32rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 18rpx;
	background: linear-gradient(145deg, var(--ink-400) 0%, var(--ink-700) 100%);
	color: var(--text-invert);
}
.activity-banner-title {
	max-width: 100%;
	font-size: var(--fs-title);
	font-weight: 600;
	text-align: center;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
.activity-banner-date {
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-caption);
	opacity: 0.75;
}

/* ---------- 小视频播放器浮层 ---------- */
.video-mask {
	position: fixed;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	z-index: 9999;
	background: #000;
}
.video-mask .video-swiper,
.video-mask .video-swiper swiper-item {
	width: 100%;
	height: 100%;
}
.video-mask .video-swiper-item {
	position: relative;
	width: 100%;
	height: 100%;
	display: flex;
	justify-content: center;
	align-items: center;
	overflow: hidden;
}
.video-mask .video-player {
	width: 100%;
	height: 100%;
	background-color: #000;
}
.video-mask .video-swiper-meta {
	position: absolute;
	left: 0;
	right: 0;
	bottom: calc(44rpx + env(safe-area-inset-bottom));
	padding: 0 32rpx;
	box-sizing: border-box;
	color: #fff;
}
.video-mask .video-swiper-title {
	font-size: 30rpx;
	font-weight: 600;
	line-height: 1.4;
	white-space: pre-line;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
}
.video-mask .video-swiper-desc {
	margin-top: 8rpx;
	font-size: 24rpx;
	line-height: 1.5;
	color: rgba(255, 255, 255, 0.75);
	white-space: pre-line;
}
.video-mask .video-close {
	position: absolute;
	right: 32rpx;
	top: calc(24rpx + env(safe-area-inset-top));
	width: 64rpx;
	height: 64rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	border-radius: 50%;
	background: rgba(255, 255, 255, 0.18);
	color: #fff;
	font-size: 30rpx;
	z-index: 10;
}
.video-mask .video-countnum {
	position: absolute;
	left: 0;
	right: 0;
	top: calc(32rpx + env(safe-area-inset-top));
	z-index: 10;
	display: flex;
	justify-content: center;
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.9);
}
