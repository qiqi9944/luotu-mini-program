/* pages/yanbao/redian.wxss */
.con{
	padding: 0 25rpx;
	padding-top: 30rpx;
	padding-bottom: 30rpx;
	background-color: #ebf6fc;
	margin-top: -70rpx;
	position: relative;
	z-index: 99;
	border-radius: 35rpx 35rpx 0 0 ;
	box-sizing: border-box;
  }
  .sellist {
	  padding-bottom: 110rpx;
  }
  .swiper {
	--box-width: 100vw;
	height: calc(var(--box-width) / 3.6);
	margin-bottom: 20rpx;
	}
  .swiper-item .pic {
	  border-radius: 20rpx;
  }
  .redian .newsbox {
	width: 100%;
	background-color: #fff;
	margin-bottom: 25rpx;
}
.redian .newsbox .down {
	width: 100%;
}

.redian .newsbox .down .item {
	width: 100%;
	padding: 30rpx 0;
	border-bottom: 1rpx solid #eee;
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.redian .newsbox .down .item:last-child {
	border-bottom: 0;
}
.redian .newsbox .down .item .l {
	width: calc(100%);
}
.redian .newsbox .down .item .r {
	width: 120rpx;
	height: auto;
	margin-left: 30rpx;
	flex-shrink: 0;
}
.redian .newsbox .down .item .shang {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	margin-bottom: 20rpx;
}

.redian .newsbox .down .item .shang .pic {
	width: 25rpx;
	margin-right: 15rpx;
	margin-top: 10rpx;
	max-height: 13px;
}

.redian .newsbox .down .item .shang .title {
	width: 100%;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
	font-size: 14px;
	color: #333;
}

.redian .newsbox .down .item .xia {
	width: 100%;
	box-sizing: border-box;
	font-size: 12px;
	color: #999;
}
.redian .newsbox .more{
	width: 100%;
	height: 110rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 14px;
	color: #333;
}



.yanbao .newsbox {
	width: 100%;
	padding-top: 40rpx;
	background-color: #fff;
	margin-bottom: 25rpx;
	border-radius: 25rpx;
}

.yanbao .newsbox .up {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: stretch;
}

.yanbao .newsbox .up .title {
	font-size: 16px;
	color: #333;
	font-weight: bold;
	display: flex;
	justify-content: flex-start;
	align-items: center;
}
.yanbao .newsbox .up .title .sp{
	color: #fff;
	background-color: #cd3824;
	border-radius: 50%;
	padding: 0 8rpx;
	margin: 0 3rpx;
}

.yanbao .newsbox .up .more {
	width: 35rpx;
	display: flex;
	justify-content: center;
	align-items: center;
}
.yanbao .newsbox .up .more image {
	width: 100%;
	max-height: 5px;
}

.yanbao .newsbox .down {
	width: 100%;
	/* min-height: 300rpx; */
}

.yanbao .newsbox .down .item {
	width: 100%;
	padding: 30rpx 0;
	border-bottom: 1rpx solid #eee;
}
.yanbao .newsbox .down .item:last-child {
	border-bottom: 0;
}

.yanbao .newsbox .down .item .shang {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	margin-bottom: 20rpx;
}

.yanbao .newsbox .down .item .shang .pic {
	width: 25rpx;
	margin-right: 15rpx;
	max-height: 12px;
}

.yanbao .newsbox .down .item .shang .title {
	width: 100%;
	white-space: nowrap;
	text-overflow: ellipsis;
	overflow: hidden;
	font-size: 14px;
	color: #333;
}

.yanbao .newsbox .down .item .xia {
	width: 100%;
	box-sizing: border-box;
	font-size: 12px;
	color: #999;
}