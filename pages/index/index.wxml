<!--index.wxml-->
<!-- banner 轮播（含洛图科技顶图作为第一项）-->
<view class="ad ad-top">
    <view class="page-section page-section-spacing swiper swiper1">
        <swiper indicator-dots="{{banner.indicatorDots}}" autoplay="{{banner.autoplay}}" circular="{{banner.circular}}" vertical="{{banner.vertical}}" interval="{{banner.interval}}" duration="{{banner.duration}}" previous-margin="{{banner.previousMargin}}px" next-margin="{{banner.nextMargin}}px" indicator-color="{{banner.indicatorColor}}" indicator-active-color="{{banner.indicatorActiveColor}}" display-multiple-items="{{banner.itemnum}}">
            <swiper-item>
                <view class="swiper-item">
                    <image src="/pages/images/banner.jpg" mode="widthFix"></image>
                </view>
            </swiper-item>
            <block wx:for="{{lunbo}}" wx:key="*this">
                <swiper-item>
                    <navigator url="{{item.url}}" class="swiper-item {{index}}">
                        <image src="{{item.pic}}" mode="widthFix"></image>
                    </navigator>
                </swiper-item>
            </block>
        </swiper>
    </view>
</view>
<view class="con">
    <!-- 导航菜单 -->
    <view class="menulist menulist--buttons">
        <view class="menu-title">市场数据</view>
        <view class="menu-grid">
            <block wx:for="{{menulist}}" wx:key="id">
                <view class="item" bindtap="nextpage" data-type="{{item.type}}">
                    <view class="item-icon">
                        <image wx:if="{{item.pic}}" src="{{item.pic}}" mode="aspectFill"></image>
                        <view wx:else class="item-icon-letter item-icon-c{{(index % 6)}}">{{item.name[0]}}</view>
                    </view>
                    <view class="title">{{item.name}}</view>
                </view>
            </block>
        </view>
    </view>
    <!-- 广告（原轮播已移至顶部，此处保留空view维持con结构） -->
    <!-- 搜索 -->
    <view class="sousuo">
        <view class="fdj" bindtap="search">
            <image src="/pages/images/fdj.png" mode="widthFix"></image>
        </view>
        <input type="text" data-name="keywords" class="input" bindinput="inputchange" bindconfirm="search" value="{{keywords}}" />
    </view>
    <!-- 行业洞察 -->
    <view class="dc">
        <view class="pubtitle">
            <view class="l">
                <image src="/pages/images/hot.png" mode="widthFix"></image>行业洞察
            </view>
            <view class="r" bindtap="toNews">
                <image src="/pages/images/dian.png" mode="widthFix"></image>
            </view>
        </view>
        <view class="dclist">
            <block wx:for="{{newslist}}" wx:key="id">
                <navigator url="../yanbao/view?id={{item.id}}" class="item">
                    <view class="p1">
                        <view class="tag t{{item.tag}}" wx:if="{{item.tag!=0}}">{{item.tag==1?'HOT':''}}{{item.tag==2?'NEW':''}}</view>
                        <view class="title">{{item.name}}</view>
                    </view>
                    <view class="p2">{{item.addtime}}</view>
                </navigator>
            </block>
        </view>
    </view>
    <view class="blank20"></view>
</view>
