<!-- pages/index/next.wxml -->
<view class="page">
	<view class="filter-card">
		<view class="selector-grid">
			<picker class="selector-cell selector-cell-main" bindchange="bindPickerChange" data-name="val0" data-real="realval0" value="{{val0}}" range-key="name" range="{{arrval0}}">
				<view class="selector-main">
					<text class="selector-label">品类</text>
					<text class="selector-value selector-value-main">{{arrval0[val0]['name']}}</text>
					<image src="/pages/images/sanjiao2.png" mode="widthFix" class="selector-arrow"></image>
				</view>
			</picker>

			<picker class="selector-cell" bindchange="bindPickerChange" data-name="val1" wx:if="{{realval0==9 || realval0==11 || realval0==12 || realval0==17}}" data-real="realval1" value="{{val1}}" range-key="name" range="{{arrval1}}">
				<view class="selector-main">
					<text class="selector-label">渠道</text>
					<text class="selector-value">{{arrval1[val1]['name']}}</text>
					<image src="/pages/images/sanjiao2.png" mode="widthFix" class="selector-arrow"></image>
				</view>
			</picker>

			<picker class="selector-cell" bindchange="bindPickerChange" data-name="val2" wx:if="{{(realval0!=5 && realval0!=6 && realval0!=7 && realval0!=9 && realval0!=10 && realval0!=11 && realval0!=12 && realval0!=18) || (realval0==12 && realval1==5)}}" data-real="realval2" value="{{val2}}" range-key="name" range="{{arrval2}}">
				<view class="selector-main">
					<text class="selector-label">销售</text>
					<text class="selector-value">{{arrval2[val2]['name']}}</text>
					<image src="/pages/images/sanjiao2.png" mode="widthFix" class="selector-arrow"></image>
				</view>
			</picker>

			<picker class="selector-cell" bindchange="bindPickerChange" data-name="val3" data-real="realval3" value="{{val3}}" range-key="name" range="{{arrval3}}">
				<view class="selector-main">
					<text class="selector-label">时间</text>
					<text class="selector-value">{{arrval3[val3]['name']}}</text>
					<image src="/pages/images/sanjiao2.png" mode="widthFix" class="selector-arrow"></image>
				</view>
			</picker>
		</view>

		<view class="selector-grid selector-grid-bottom">
			<view class="selector-cell selector-cell-ghost">
				<view class="selector-main">
					<text class="selector-label">变化</text>
					<text class="selector-value selector-value-ghost">同比</text>
				</view>
			</view>
			<view class="selector-cell selector-cell-ghost">
				<view class="selector-main">
					<text class="selector-label">期间</text>
					<text class="selector-value selector-value-ghost">当前</text>
				</view>
			</view>
			<view class="selector-cell selector-cell-ghost">
				<view class="selector-main">
					<text class="selector-label">累计</text>
					<text class="selector-value selector-value-ghost">年累计</text>
				</view>
			</view>
		</view>
	</view>

	<view class="tabbar">
		<view class="tabitem {{activeTab=='scale'?'active':''}}" bindtap="switchTab" data-tab="scale">行业规模</view>
		<view class="tabitem {{activeTab=='brand'?'active':''}}" bindtap="switchTab" data-tab="brand">品牌竞争</view>
		<view class="tabitem {{activeTab=='price'?'active':''}}" bindtap="switchTab" data-tab="price">价格分布</view>
		<view class="tabitem {{activeTab=='structure'?'active':''}}" bindtap="switchTab" data-tab="structure">产品结构</view>
		<view class="tabitem {{activeTab=='ai'?'active':''}}" bindtap="switchTab" data-tab="ai">AI说</view>
	</view>

	<view wx:if="{{!xqData || xqData.length==0}}" class="empty-state">
		<image src="/pages/images/error.png" mode="widthFix" class="empty-icon"></image>
		<view class="empty-text">正在建设中，敬请期待...</view>
	</view>

	<block wx:else>
		<view class="panel" wx:if="{{activeTab=='scale'}}">
			<view class="metric-grid">
				<block wx:for="{{xqData}}" wx:key="this">
					<view class="metric-card">
						<text class="metric-label">{{item.t1}}</text>
						<view class="metric-row">
							<text class="metric-num">{{item.t2}}</text>
							<text class="metric-unit">{{item.dw}}</text>
						</view>
						<view class="metric-yoy">
							<text class="metric-yoy-label">同比</text>
							<text class="metric-yoy-val {{item.t3zf=='+'?'up':item.t3zf=='-'?'down':''}}">{{item.t3}}</text>
							<image src="../images/sheng1.png" mode="widthFix" class="metric-arrow" wx:if="{{item.t3zf=='+'}}"></image>
							<image src="../images/jiang1.png" mode="widthFix" class="metric-arrow" wx:if="{{item.t3zf=='-'}}"></image>
						</view>
					</view>
				</block>
			</view>

			<view class="chart-card">
				<view class="card-head">
					<view class="card-title">销量（{{arr_sj2_dw}}）</view>
					<view class="card-sub">同比</view>
				</view>
				<view class="chart-frame">
					<ec-canvas id="mychart-dom-bar" force-use-old-canvas="true" class="chartdom" canvas-id="mychart-bar" ec="{{ ec }}"></ec-canvas>
				</view>
			</view>

			<view class="chart-card" hidden="{{!chart2x.length}}">
				<view class="card-head">
					<view class="card-title">平均价格（元）</view>
					<view class="card-sub">同比</view>
				</view>
				<view class="chart-frame">
					<ec-canvas id="mychart-dom-bar2" force-use-old-canvas="true" class="chartdom" canvas-id="mychart-bar" ec="{{ ec2 }}"></ec-canvas>
				</view>
			</view>
		</view>

		<view class="panel" wx:if="{{activeTab=='brand'}}">
			<view class="chart-card" hidden="{{!chart3.length}}">
				<view class="card-head">
					<view class="card-title">品牌销量份额(%)</view>
				</view>
				<view class="chart-frame chart-frame-pie">
					<ec-canvas id="mychart-dom-bar3" force-use-old-canvas="true" class="chartdom" canvas-id="mychart-bar" ec="{{ ec3 }}"></ec-canvas>
				</view>
			</view>
			<view class="empty-text" hidden="{{chart3.length}}">暂无品牌竞争数据</view>
		</view>

		<view class="panel" wx:if="{{activeTab=='price'}}">
			<view class="chart-card" hidden="{{!priceList.length}}">
				<view class="card-head">
					<view class="card-title">价格分布</view>
				</view>
				<view class="price-table">
					<view class="price-table-head">
						<view class="price-cell price-cell-name">价格段</view>
						<view class="price-cell price-cell-share">市占率</view>
						<view class="price-cell price-cell-change">市占率增减</view>
					</view>
					<block wx:for="{{priceList}}" wx:key="index">
						<view class="price-table-row">
							<view class="price-cell price-cell-name">{{item.t1}}</view>
							<view class="price-cell price-cell-share">{{item.t2}}</view>
							<view class="price-cell price-cell-change">
								<text class="price-change {{item.t3zf=='+'?'up':item.t3zf=='-'?'down':''}}">{{item.t3}}</text>
								<image src="../images/sheng1.png" mode="widthFix" class="price-arrow" wx:if="{{item.t3zf=='+'}}"></image>
								<image src="../images/jiang1.png" mode="widthFix" class="price-arrow" wx:if="{{item.t3zf=='-'}}"></image>
							</view>
						</view>
					</block>
				</view>
			</view>
			<view class="empty-text" hidden="{{priceList.length}}">暂无价格分布数据</view>
		</view>

		<view class="panel" wx:if="{{activeTab=='structure'}}">
			<view class="chart-card" hidden="{{(!arr_sj6.t1 && !arr_sj6.t2)?true:false}}">
				<view class="card-head">
					<view class="card-title" wx:if="{{realval1 == 10}}">地区出口量结构(%)</view>
					<view class="card-title" wx:else>产品结构(%)</view>
				</view>
				<view class="chart-frame chart-frame-pie" hidden="{{!arr_sj6.t1}}">
					<ec-canvas id="mychart-dom-bar3" force-use-old-canvas="true" class="chartdom" canvas-id="mychart-bar" ec="{{ ec3 }}"></ec-canvas>
				</view>
				<view class="divider" hidden="{{!arr_sj6.t1 || !arr_sj6.t2}}"></view>
				<view class="chart-frame chart-frame-pie" hidden="{{!arr_sj6.t2}}">
					<ec-canvas id="mychart-dom-bar4" force-use-old-canvas="true" class="chartdom" canvas-id="mychart-bar" ec="{{ ec4 }}"></ec-canvas>
				</view>
			</view>
		</view>

		<view class="panel" wx:if="{{activeTab=='ai'}}">
			<view class="chart-card">
				<view class="card-head">
					<view class="card-title">AI说</view>
				</view>
				<view class="ai-box">{{tips ? tips : '暂无AI解读'}}</view>
			</view>
		</view>

		<view class="source-note">{{tips}}</view>
	</block>

	<view class="blank20"></view>
</view>
