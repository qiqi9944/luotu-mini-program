.menulist--buttons .item .title {
	width: 100%;
	padding: 0 2rpx;
	box-sizing: border-box;
	font-size: 27rpx;
	font-weight: 600;
	line-height: 1.3;
	color: var(--text-1);
	overflow-wrap: break-word;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
}

/* ---------- 行业洞察 ---------- */
.dc {
	box-sizing: border-box;
	padding: 28rpx 24rpx;
	background-color: var(--surface);
	border-radius: var(--r-lg);
	box-shadow: var(--shadow-card);
}
.pubtitle {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding-bottom: 18rpx;
	margin-bottom: 6rpx;
	border-bottom: 1rpx solid var(--hairline);
	position: relative;
}
/* 红→琥珀光谱线：与「市场数据」的蓝线形成冷暖对位 */
.pubtitle::after {
	content: "";
	position: absolute;
	left: 0;
	bottom: -1rpx;
	width: 132rpx;
	height: 4rpx;
	border-radius: 4rpx;
	background: linear-gradient(90deg, var(--c-red) 0%, var(--c-orange) 55%, var(--c-amber) 100%);
}
.pubtitle .l {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-size: var(--fs-title);
	font-weight: 600;
	color: var(--text-1);
	letter-spacing: 1rpx;
}
.pubtitle .l::before {
	content: "";
	width: 6rpx;
	height: 30rpx;
	margin-right: 14rpx;
	border-radius: 6rpx;
	flex-shrink: 0;
	background: linear-gradient(180deg, var(--c-red) 0%, var(--c-orange) 100%);
}
.pubtitle .l image {
	width: 30rpx;
	margin-right: 12rpx;
}
.pubtitle .r {
	width: 40rpx;
	height: 40rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	flex-shrink: 0;
}
.pubtitle .r image {
	width: 30rpx;
	opacity: 0.5;
}

.dclist {
	width: 100%;
}
.dclist .item {
	width: 100%;
	display: flex;
	align-items: flex-start;
	padding: 26rpx 12rpx 26rpx 0;
	margin: 0 -12rpx;
	border-bottom: 1rpx solid var(--hairline);
	border-radius: var(--r-sm);
	box-sizing: border-box;
}
.dclist .item:last-child {
	border-bottom: 0;
}

/* 序号：报告类产品的编辑式细节，做成小色块；前三名用蓝/红/橙标记热度 */
.dclist .item .ord {
	width: 44rpx;
	height: 44rpx;
	margin-left: 6rpx;
	margin-right: 10rpx;
	flex-shrink: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 10rpx;
	box-sizing: border-box;
	background-color: var(--ink-050);
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: 22rpx;
	font-weight: 700;
	line-height: 1;
	color: var(--ink-400);
}
.dclist .item:nth-child(1) .ord {
	background-color: var(--c-blue-soft);
	color: var(--c-blue-ink);
}
.dclist .item:nth-child(2) .ord {
	background-color: var(--c-red-soft);
	color: var(--c-red-ink);
}
.dclist .item:nth-child(3) .ord {
	background-color: var(--c-orange-soft);
	color: var(--c-orange-ink);
}
.dclist .item .body {
	flex: 1;
	min-width: 0;
}
.dclist .item .p1 {
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	margin-bottom: 12rpx;
}
.dclist .item .p1 .title {
	flex: 1;
	min-width: 0;
	font-size: var(--fs-body);
	line-height: 1.45;
	color: var(--text-1);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* 标签：HOT 用琥珀信号色，NEW 用墨蓝描边。
   红色在本项目已被「同比上涨」占用，此处不再复用，避免语义串味。*/
.dclist .item .p1 .tag {
	flex-shrink: 0;
	margin-right: 12rpx;
	padding: 2rpx 10rpx;
	border-radius: var(--r-sm);
	font-family: var(--font-num);
	font-size: 18rpx;
	font-weight: 700;
	line-height: 1.7;
	letter-spacing: 1rpx;
}
.dclist .item .p1 .tag.t1 {
	color: #8a4f05;
	background-color: var(--signal-soft);
	border: 1rpx solid rgba(217, 139, 38, 0.4);
}
.dclist .item .p1 .tag.t2 {
	color: var(--ink-600);
	background-color: var(--ink-050);
	border: 1rpx solid var(--hairline-strong);
}
.dclist .item .p2 {
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-caption);
	letter-spacing: 0.5rpx;
	color: var(--text-3);
}
