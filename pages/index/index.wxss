/**index.wxss — 首页：顶部轮播 → 纸面浮起 → 数据宫格 / 行业洞察 */
page {
	background-color: var(--ink-900);
}

/* ---------- 顶部轮播 ---------- */
.ad {
	width: 100%;
	margin-bottom: 24rpx;
}
.ad-top {
	width: 100%;
	margin-bottom: 0;
	background-color: var(--ink-900);
}
.ad-top .swiper {
	height: calc(100vw / 1.923);
	margin-bottom: 0;
}
.ad-top .swiper-item {
	border-radius: 0;
}
/* 顶部通栏轮播需要撑满固定高度（覆盖 app.wxss 的 height:auto） */
swiper-item {
	height: 100% !important;
	background-repeat: no-repeat;
	background-position: center;
	background-size: cover;
}
.ad-top .swiper image {
	width: 100%;
	height: 100%;
	display: block;
	object-fit: cover;
}

/* ---------- 内容纸面：压住轮播下缘浮起，顶边一道高光发丝线 ---------- */
.con {
	position: relative;
	z-index: 99;
	box-sizing: border-box;
	padding: 30rpx var(--gutter) 0;
	margin-top: -56rpx;
	background-color: var(--paper);
	border-radius: var(--r-sheet) var(--r-sheet) 0 0;
	border-top: 1rpx solid rgba(255, 255, 255, 0.5);
	box-shadow: 0 -12rpx 32rpx rgba(3, 37, 60, 0.18);
}

/* ---------- 搜索：置于宫格之上，作为全页第一动作 ---------- */
.sousuo {
	width: 100%;
	height: 88rpx;
	display: flex;
	justify-content: flex-start;
	align-items: stretch;
	margin-bottom: 24rpx;
	box-sizing: border-box;
	background-color: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: 999rpx;
	box-shadow: var(--shadow-card);
}
.sousuo .fdj {
	width: 88rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	flex-shrink: 0;
	position: relative;
}
/* 放大镜底座：品牌蓝浅底圆点，作为首页第一个颜色锚点 */
.sousuo .fdj::before {
	content: "";
	position: absolute;
	width: 48rpx;
	height: 48rpx;
	border-radius: 50%;
	background: linear-gradient(135deg, var(--c-blue-soft) 0%, var(--ink-050) 100%);
}
.sousuo .fdj image {
	width: 26rpx;
	height: auto;
	opacity: 0.85;
	position: relative;
	z-index: 1;
}
.sousuo .input {
	flex: 1;
	height: 100%;
	padding-right: 32rpx;
	box-sizing: border-box;
	font-size: var(--fs-body);
	color: var(--text-1);
}
.sousuo-ph {
	color: var(--text-3);
	font-size: var(--fs-body);
}

/* ---------- 搜索联动：品类联想下拉（胶囊标签） ---------- */
.search-suggest {
	box-sizing: border-box;
	margin-top: -8rpx;
	margin-bottom: 24rpx;
	padding: 16rpx 18rpx 8rpx;
	background-color: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: var(--r-md);
	box-shadow: var(--shadow-card);
}
.search-suggest .suggest-hd {
	padding: 0 2rpx 12rpx;
	font-size: var(--fs-caption);
	color: var(--text-3);
	letter-spacing: 1rpx;
}
.search-suggest .suggest-tags {
	width: 100%;
	white-space: nowrap;
}
.search-suggest .suggest-tag {
	display: inline-block;
	vertical-align: middle;
	margin-right: 14rpx;
	padding: 12rpx 26rpx;
	border-radius: 999rpx;
	background-color: var(--c-blue-soft);
	color: var(--c-blue-ink);
	font-size: var(--fs-body-s);
	font-weight: 600;
	line-height: 1.2;
}
.search-suggest .suggest-tag:last-child {
	margin-right: 0;
}

/* ---------- 数据宫格 ---------- */
.menulist--buttons {
	display: block;
	box-sizing: border-box;
	padding: 24rpx 22rpx 10rpx;
	margin-bottom: 24rpx;
	background-color: var(--surface);
	border-radius: var(--r-lg);
	box-shadow: var(--shadow-card);
}

/* 分组卡片：每组一张白卡，卡间留白，最后一张贴住下一区块 */
.menu-section {
	margin-bottom: 24rpx;
}
.menu-card {
	margin-bottom: 16rpx;
	padding: 12rpx 22rpx 10rpx;
}
.menu-card:last-child {
	margin-bottom: 0;
}

/* 中文主标题 + 英文小标题，制造编辑式的双行节奏 */
.menu-head {
	display: flex;
	align-items: baseline;
	margin-bottom: 24rpx;
	padding-bottom: 18rpx;
	border-bottom: 1rpx solid var(--hairline);
	position: relative;
}
/* 标准色板光谱线：蓝→红为主，呼应产品结构配色 */
.menu-head::after {
	content: "";
	position: absolute;
	left: 0;
	bottom: -1rpx;
	width: 132rpx;
	height: 4rpx;
	border-radius: 4rpx;
	background: linear-gradient(90deg, var(--c-blue) 0%, var(--c-indigo) 40%, var(--c-red) 100%);
}
.menu-title {
	display: flex;
	align-items: center;
	font-size: var(--fs-title);
	font-weight: 600;
	color: var(--text-1);
	letter-spacing: 1rpx;
}
.menu-title::before {
	content: "";
	width: 6rpx;
	height: 30rpx;
	margin-right: 14rpx;
	border-radius: 6rpx;
	flex-shrink: 0;
	background: linear-gradient(180deg, var(--c-blue) 0%, var(--ink-700) 100%);
}
.menu-sub {
	margin-left: 16rpx;
	font-family: var(--font-num);
	font-size: var(--fs-caption);
	letter-spacing: 3rpx;
	color: var(--c-blue);
	opacity: 0.6;
}

/* 三列等宽栅格，9 个品类正好排成 3×3 */
.menu-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	column-gap: 8rpx;
	row-gap: 4rpx;
}

/* 品类入口：软底色圆角图标 + 分类名称，收紧留白、更紧凑 */
.menulist--buttons .item {
	position: relative;
	box-sizing: border-box;
	min-height: 98rpx;
	padding: 8rpx 4rpx 8rpx;
	border-radius: var(--r-md);
	background-color: var(--surface);
	display: flex;
	align-items: center;
	justify-content: center;
	flex-direction: column;
	text-align: center;
	overflow: hidden;
	transition: transform 0.15s ease, box-shadow 0.15s ease;
}

/* 图标容器：去掉底色方块，图标直接落在纸面上，靠双色图标本身承载颜色 */
.menulist--buttons .item .icon {
	width: 58rpx;
	height: 58rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-bottom: 8rpx;
	flex-shrink: 0;
}

/* 彩色线性图标：24×24 视框、圆角端点细描边，按行分组着色（蓝/红/青），内联为矢量 SVG。 */
