/**index.wxss — 首页：顶部轮播 → 纸面浮起 → 数据宫格 / 行业洞察 */
page {
	background-color: var(--ink-900);
}

/* ---------- 顶部轮播 ---------- */
.ad {
	width: 100%;
	margin-bottom: 24rpx;
}
.ad-top {
	width: 100%;
	margin-bottom: 0;
	background-color: var(--ink-900);
}
.ad-top .swiper {
	height: calc(100vw / 1.923);
	margin-bottom: 0;
}
.ad-top .swiper-item {
	border-radius: 0;
}
/* 顶部通栏轮播需要撑满固定高度（覆盖 app.wxss 的 height:auto） */
swiper-item {
	height: 100% !important;
	background-repeat: no-repeat;
	background-position: center;
	background-size: cover;
}
.ad-top .swiper image {
	width: 100%;
	height: 100%;
	display: block;
	object-fit: cover;
}

/* ---------- 内容纸面：压住轮播下缘浮起，顶边一道高光发丝线 ---------- */
.con {
	position: relative;
	z-index: 99;
	box-sizing: border-box;
	padding: 30rpx var(--gutter) 0;
	margin-top: -56rpx;
	background-color: var(--paper);
	border-radius: var(--r-sheet) var(--r-sheet) 0 0;
	border-top: 1rpx solid rgba(255, 255, 255, 0.5);
	box-shadow: 0 -12rpx 32rpx rgba(3, 37, 60, 0.18);
}

/* ---------- 搜索：置于宫格之上，作为全页第一动作 ---------- */
.sousuo {
	width: 100%;
	height: 88rpx;
	display: flex;
	justify-content: flex-start;
	align-items: stretch;
	margin-bottom: 24rpx;
	box-sizing: border-box;
	background-color: var(--surface);
	border: 1rpx solid var(--hairline);
	border-radius: 999rpx;
	box-shadow: var(--shadow-card);
}
.sousuo .fdj {
	width: 88rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	flex-shrink: 0;
}
.sousuo .fdj image {
	width: 32rpx;
	height: auto;
	opacity: 0.72;
}
.sousuo .input {
	flex: 1;
	height: 100%;
	padding-right: 32rpx;
	box-sizing: border-box;
	font-size: var(--fs-body);
	color: var(--text-1);
}
.sousuo-ph {
	color: var(--text-3);
	font-size: var(--fs-body);
}

/* ---------- 数据宫格 ---------- */
.menulist--buttons {
	display: block;
	box-sizing: border-box;
	padding: 28rpx 24rpx 6rpx;
	margin-bottom: 24rpx;
	background-color: var(--surface);
	border-radius: var(--r-lg);
	box-shadow: var(--shadow-card);
}

/* 中文主标题 + 英文小标题，制造编辑式的双行节奏 */
.menu-head {
	display: flex;
	align-items: baseline;
	margin-bottom: 24rpx;
	padding-bottom: 18rpx;
	border-bottom: 1rpx solid var(--hairline);
}
.menu-title {
	display: flex;
	align-items: center;
	font-size: var(--fs-title);
	font-weight: 600;
	color: var(--text-1);
	letter-spacing: 1rpx;
}
.menu-title::before {
	content: "";
	width: 6rpx;
	height: 30rpx;
	margin-right: 14rpx;
	border-radius: 6rpx;
	flex-shrink: 0;
	background: linear-gradient(180deg, var(--ink-400) 0%, var(--ink-700) 100%);
}
.menu-sub {
	margin-left: 16rpx;
	font-family: var(--font-num);
	font-size: var(--fs-caption);
	letter-spacing: 3rpx;
	color: var(--text-3);
}

.menu-grid {
	display: flex;
	flex-wrap: wrap;
	justify-content: flex-start;
}
.menulist--buttons .item {
	width: calc((100% - 36rpx) / 3);
	box-sizing: border-box;
	padding: 24rpx 8rpx 22rpx;
	margin-right: 18rpx;
	margin-bottom: 18rpx;
	background-color: var(--surface-sunken);
	border: 1rpx solid var(--hairline);
	border-radius: var(--r-md);
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: flex-start;
	transition: transform 0.18s cubic-bezier(0.2, 0.8, 0.3, 1), opacity 0.18s ease;
}
.menulist--buttons .item:nth-child(3n) {
	margin-right: 0;
}
.menulist--buttons .item .item-icon {
	width: 84rpx;
	height: 84rpx;
	border-radius: var(--r-md);
	overflow: hidden;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-bottom: 16rpx;
	background: linear-gradient(145deg, var(--ink-400) 0%, var(--ink-700) 100%);
}
.menulist--buttons .item .item-icon image {
	width: 100%;
	height: 100%;
	display: block;
}
.menulist--buttons .item .item-icon-letter {
	font-family: var(--font-num);
	font-size: 44rpx;
	font-weight: 700;
	color: var(--text-invert);
}

/* 六个首字母底色改为「同一冷色族的六个色阶」：
   原来的橙/绿/紫/粉/蓝/金彩虹与墨蓝品牌互相打架，
   收敛到青—蓝—靛的窄色域后，宫格才读得出是一套系统。*/
.menulist--buttons .item .item-icon-c0 {
	background: linear-gradient(145deg, #4ea6cc 0%, #17698f 100%);
}
.menulist--buttons .item .item-icon-c1 {
	background: linear-gradient(145deg, #2f7fae 0%, #063f63 100%);
}
.menulist--buttons .item .item-icon-c2 {
	background: linear-gradient(145deg, #55b0b4 0%, #17667a 100%);
}
.menulist--buttons .item .item-icon-c3 {
	background: linear-gradient(145deg, #2a6f9c 0%, #052b45 100%);
}
.menulist--buttons .item .item-icon-c4 {
	background: linear-gradient(145deg, #6f9fc8 0%, #2b5f88 100%);
}
.menulist--buttons .item .item-icon-c5 {
	background: linear-gradient(145deg, #1e5f86 0%, #03253c 100%);
}

.menulist--buttons .item .title {
	width: 100%;
	text-align: center;
	font-size: var(--fs-body-s);
	line-height: 1.3;
	color: var(--text-2);
	white-space: normal;
	word-break: break-all;
}

/* ---------- 行业洞察 ---------- */
.dc {
	box-sizing: border-box;
	padding: 28rpx 24rpx;
	background-color: var(--surface);
	border-radius: var(--r-lg);
	box-shadow: var(--shadow-card);
}
.pubtitle {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding-bottom: 18rpx;
	margin-bottom: 6rpx;
	border-bottom: 1rpx solid var(--hairline);
}
.pubtitle .l {
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-size: var(--fs-title);
	font-weight: 600;
	color: var(--text-1);
	letter-spacing: 1rpx;
}
.pubtitle .l image {
	width: 30rpx;
	margin-right: 12rpx;
}
.pubtitle .r {
	width: 40rpx;
	height: 40rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	flex-shrink: 0;
}
.pubtitle .r image {
	width: 30rpx;
	opacity: 0.5;
}

.dclist {
	width: 100%;
}
.dclist .item {
	width: 100%;
	display: flex;
	align-items: flex-start;
	padding: 26rpx 12rpx 26rpx 0;
	margin: 0 -12rpx;
	border-bottom: 1rpx solid var(--hairline);
	border-radius: var(--r-sm);
	box-sizing: border-box;
}
.dclist .item:last-child {
	border-bottom: 0;
}

/* 序号：报告类产品的编辑式细节，用数字字体压小、退到次要层级 */
.dclist .item .ord {
	width: 56rpx;
	flex-shrink: 0;
	padding-left: 12rpx;
	box-sizing: border-box;
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-body-s);
	font-weight: 700;
	line-height: 1.5;
	color: var(--ink-200);
}
.dclist .item .body {
	flex: 1;
	min-width: 0;
}
.dclist .item .p1 {
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	margin-bottom: 12rpx;
}
.dclist .item .p1 .title {
	flex: 1;
	min-width: 0;
	font-size: var(--fs-body);
	line-height: 1.45;
	color: var(--text-1);
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
}

/* 标签：HOT 用琥珀信号色，NEW 用墨蓝描边。
   红色在本项目已被「同比上涨」占用，此处不再复用，避免语义串味。*/
.dclist .item .p1 .tag {
	flex-shrink: 0;
	margin-right: 12rpx;
	padding: 2rpx 10rpx;
	border-radius: var(--r-sm);
	font-family: var(--font-num);
	font-size: 18rpx;
	font-weight: 700;
	line-height: 1.7;
	letter-spacing: 1rpx;
}
.dclist .item .p1 .tag.t1 {
	color: #8a4f05;
	background-color: var(--signal-soft);
	border: 1rpx solid rgba(217, 139, 38, 0.4);
}
.dclist .item .p1 .tag.t2 {
	color: var(--ink-600);
	background-color: var(--ink-050);
	border: 1rpx solid var(--hairline-strong);
}
.dclist .item .p2 {
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-size: var(--fs-caption);
	letter-spacing: 0.5rpx;
	color: var(--text-3);
}
