/* pages/index/next.wxss */
.sellist {
	padding-bottom: 110rpx;
}

.box {
	width: 100%;
	padding: 30rpx 0;
	background-color: #fff;
	border-radius: 6px;
	margin-bottom: 20rpx;
	box-shadow: 0 0 15rpx #ddd;
}

.box .up {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 35rpx;
}

.box .up2 {
	align-items: flex-end;
}

.box .up3 {
	box-sizing: border-box;
	padding-left: 25rpx;
	margin-bottom: 0;
}

.box .up4 {
	box-sizing: border-box;
	padding-left: 25rpx;
}

.box .up .l {
	display: flex;
	justify-content: flex-start;
	align-items: center;
}

.box .up .l2 {
	margin-left: 25rpx;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	justify-content: flex-start;
}

.box .up .l2 .select {
	margin-bottom: 20rpx;
}

.box .up .l2 .select:last-child {
	margin-bottom: 0;
}

.box .up .l2 .select .picker {
	box-sizing: border-box;
	border: 1rpx solid #055586;
	min-width: 240rpx;
	height: 45rpx;
	font-size: 12px;
	color: #333;
	padding-left: 10rpx;
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.box .up .l2 .select .picker .sanjiao {
	margin-right: 15rpx;
	width: 15rpx;
}

.box .up .l .fk {
	width: 6rpx;
	height: 15rpx;
	background-color: #ca3828;
	margin-right: 5rpx;
	border-radius: 10rpx;
}

.box .up .l .fk2 {
	width: 6rpx;
	height: 20rpx;
	background-color: #ca3828;
	margin-right: 15rpx;
	border-radius: 10rpx;
}

.box .up .l .title {
	font-size: 16px;
	color: #333;
}

.box .up .r {
	display: flex;
	justify-content: flex-end;
	align-items: center;
}

.box .up .r .item {
	width: 80rpx;
	height: 35rpx;
	box-sizing: border-box;
	display: flex;
	justify-content: center;
	align-items: center;
	color: #2489f0;
	border: 1px solid #2489f0;
	background-color: #fff;
	font-size: 11px;
}

.box .up .r .item.hover {
	background-color: #2489f0;
	color: #fff;
}

.box .up .r .item:first-child {
	border-radius: 3px 0 0 3px;
}

.box .up .r .item:last-child {
	border-radius: 0 3px 3px 0;
	margin-right: 25rpx;
}

.tips {
	width: 100%;
	font-size: 12px;
	color: #9999ac;
	padding: 0 25rpx;
	box-sizing: border-box;
	text-align: right;
}

.box .down {
	width: 100%;
	padding: 0 25rpx;
	box-sizing: border-box;
}

.box .down .tjlist {
	width: 100%;
	display: flex;
	justify-content: space-around;
	align-items: stretch;
	margin-bottom: 35rpx;
}

.box .down .tjlist .item {
	/* width: 50%; */
	display: flex;
	justify-content: center;
	align-items: flex-start;
	flex-direction: column;
	align-content: stretch;
}

.box .down .tjlist .item .p1 {
	font-size: 12px;
	color: #888;

}

.box .down .tjlist .item .p2 {
	display: flex;
	justify-content: flex-start;
	align-items: flex-end;
	margin-bottom: 10rpx;
}

.box .down .tjlist .item .p2 .a1 {
	display: flex;
	justify-content: flex-start;
	align-items: flex-end;
	font-size: 14px;
	color: #055586;
	margin-right: 30rpx;
}

.box .down .tjlist .item .p2 .a1 .num {
	font-size: 26px;
	color: #055586;
	font-weight: bold;
	line-height: 25px;
}

.box .down .tjlist .item .p2 .a2 {
	font-size: 14px;
	color: #fb474f;
}

.box .down .table .num {
	font-size: 16px;
	color: #444;
	margin-right: 10rpx;
	font-weight: bold;
}

.box .down .table .num2 {
	font-size: 10px;
	display: flex;
	justify-content: flex-start;
	align-items: center;
	font-weight: bold;
}

.box .down .table .num2 .img {
	width: 15rpx;
	margin-left: 10rpx;
}

ec-canvas {
	width: 100%;
	height: 100%;
	/* position: absolute;
	top: 0;
	left: 0; */
}

.chart {
	width: 100%;
	height: 300px;
	box-sizing: border-box;
	/* padding-top: 25rpx; */
	/* padding: 25rpx; */
	background-color: #fff;
	border-radius: 10px;
	/* margin-bottom: 20rpx; */
	display: flex;
	justify-content: center;
	align-items: center;
}

.chart2 {
	padding: 0 25rpx;
}

.bold {
	font-weight: bold;
}

.page {
  min-height: 100vh;
  background: var(--paper);
  padding: 18rpx 18rpx 28rpx;
  box-sizing: border-box;
}

.filter-card,
.chart-card,
.empty-state {
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}

.filter-card {
  padding: 18rpx 16rpx;
}

.selector-grid {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.selector-row {
  display: flex;
  gap: 12rpx;
}

.selector-cell {
  display: block;
  min-width: 0;
  flex: 1;
}

.selector-cell-wide {
  width: 100%;
  flex: none;
}

.selector-main {
  width: 100%;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 16rpx 16rpx 14rpx;
  background: var(--surface-sunken);
  border: 1rpx solid var(--hairline-strong);
  border-radius: var(--r-md);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.selector-label {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-3);
  line-height: 1;
}

.selector-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.selector-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--ink-700);
  font-weight: 700;
  line-height: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.selector-arrow {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

.tabbar {
  display: flex;
  align-items: center;
  gap: 0;
  margin: 18rpx 0 12rpx;
  background: #fff;
  border-bottom: 1rpx solid #d7e0e8;
}

.tabitem {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #768494;
  padding: 18rpx 0 14rpx;
  border-bottom: 4rpx solid transparent;
}

.tabitem.active {
  color: #1f6b9d;
  font-weight: 700;
  border-bottom-color: #1f6b9d;
}

.panel {
  display: block;
}

.chart-card {
  padding: 18rpx 16rpx 14rpx;
  margin-bottom: 16rpx;
}

.card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2a37;
}

.card-sub {
  font-size: 20rpx;
  color: #8a97a7;
}

.chart-frame {
  width: 100%;
  height: 340rpx;
}

.chart-frame-pie {
  height: 320rpx;
}

.price-table {
  border: 1rpx solid #1f6b9d;
  border-bottom: 0;
}

.price-table-head,
.price-table-row {
  display: flex;
  align-items: stretch;
}

.price-table-head {
  background: #1f6b9d;
}

.price-table-row {
  border-top: 1rpx solid #1f6b9d;
  background: #fff;
}

.price-cell {
  box-sizing: border-box;
  padding: 26rpx 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: #1f2a37;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #1f6b9d;
}

.price-table-head .price-cell {
  color: #fff;
  font-weight: 700;
}

.price-cell:last-child {
  border-right: 0;
}

.price-cell-name {
  flex: 1.05;
}

.price-cell-share {
  flex: 1;
  color: #e04a5c;
  font-weight: 700;
}

.price-cell-change {
  flex: 1.2;
  color: #e04a5c;
  font-weight: 700;
}

.brand-cell-name {
  flex: 1.2;
  justify-content: flex-start;
  text-align: left;
  padding-left: 16rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.brand-cell-share {
  flex: 1;
  color: #e04a5c;
  font-weight: 700;
}

.brand-cell-change {
  flex: 1.15;
  color: #e04a5c;
  font-weight: 700;
}

.brand-cell-price {
  flex: 1.15;
  color: #1f6b9d;
  font-weight: 700;
}

.brand-cell-pricec {
  flex: 1.1;
  color: #e04a5c;
  font-weight: 700;
}

.price-change {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.price-change.down {
  color: #2f9e79;
}

.price-arrow {
  width: 18rpx;
  height: 18rpx;
  flex-shrink: 0;
}

.chartdom {
  width: 100%;
  height: 100%;
  display: block;
}

.divider {
  height: 1rpx;
  background: #e6edf3;
  margin: 10rpx 0;
}

.ai-box {
  font-size: 24rpx;
  line-height: 1.8;
  color: #4f5d6b;
  background: #f7fbfe;
  border-radius: 6rpx;
  padding: 18rpx 16rpx;
}

.ai-summary-card {
  padding: 20rpx 16rpx;
  margin-bottom: 16rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-card);
}

.ai-summary-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 14rpx 8rpx;
  border-bottom: 1rpx solid #edf1f4;
}

.ai-summary-item:last-child {
  border-bottom: 0;
}

.ai-summary-icon {
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #318bd0;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.ai-summary-icon-brand {
  background: #3b90d2;
  font-size: 24rpx;
}

.ai-summary-icon-product {
  background: #397fc7;
  font-size: 34rpx;
}

.ai-summary-icon-price {
  background: #3986c8;
  font-size: 30rpx;
}

.ai-summary-content {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  column-gap: 8rpx;
  row-gap: 4rpx;
  line-height: 1.45;
}

.ai-summary-title {
  color: #1f6b9d;
  font-size: 25rpx;
  font-weight: 700;
}

.ai-summary-text,
.ai-summary-value,
.ai-summary-highlight {
  font-size: 25rpx;
}

.ai-summary-text {
  color: #4f5964;
}

.ai-summary-value,
.ai-summary-highlight {
  font-weight: 700;
}

.ai-summary-value.up,
.ai-summary-highlight.up {
  color: #55a36c;
}

.ai-summary-value.down,
.ai-summary-highlight.down {
  color: #e04a5c;
}

.ai-summary-value.muted,
.ai-summary-highlight.muted {
  color: #8a97a7;
}

.ai-summary-arrow {
  margin-left: 10rpx;
  color: #aab5bf;
  font-size: 38rpx;
  line-height: 1;
}

.source-note {
  margin: 8rpx 4rpx 0;
  font-size: 22rpx;
  color: #8a97a7;
  text-align: center;
}

.empty-state {
  margin-top: 18rpx;
  padding: 42rpx 20rpx 30rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  margin: 0 auto 10rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #8a97a7;
}

