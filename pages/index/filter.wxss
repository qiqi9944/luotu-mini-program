/* pages/index/filter.wxss */
page {
  background: #eef3f8;
}

.page {
  padding: 18rpx 18rpx 28rpx;
  box-sizing: border-box;
}

/* 筛选 */
.filters {
  margin-top: 14rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 16rpx 14rpx 6rpx;
  box-shadow: 0 8rpx 20rpx rgba(24, 58, 95, 0.05);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2a37;
}

.section-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a97a7;
}

.filter-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.picker-item {
  width: calc((100% - 20rpx) / 3);
  display: block;
}

.fsel {
  width: 100%;
  box-sizing: border-box;
  min-height: 78rpx;
  padding: 10rpx 10rpx;
  margin-bottom: 10rpx;
  background: #fff;
  border: 1rpx solid #2a6e8c;
  border-radius: 6rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
  box-shadow: none;
}

.fsel:active {
  background: #f4fbff;
}

.flabel {
  font-size: 22rpx;
  color: #121212;
  font-weight: 600;
  line-height: 1;
  flex-shrink: 0;
}

.fmeta {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  margin-top: 0;
  min-width: 0;
  flex: 1;
}

.fval {
  flex: 1;
  font-size: 20rpx;
  color: #1f6b9d;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
  line-height: 1;
  display: block;
}

.farrow {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  opacity: 0.55;
}

/* 指标卡 */
.ind {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.inditem {
  width: calc((100% - 24rpx) / 3);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
}

.ind2 {
  width: 100%;
}

.inditem .p1 {
  font-size: 24rpx;
  color: #7d8a99;
}

.inditem .p2 {
  margin: 12rpx 0 10rpx;
}

.inditem .num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1677c8;
}

.inditem .dw {
  font-size: 22rpx;
  color: #7d8a99;
  margin-left: 6rpx;
}

.inditem .p3 {
  font-size: 22rpx;
  color: #7d8a99;
}

.inditem .p3.up {
  color: #e04a5c;
}

.inditem .p3.down {
  color: #2f9e79;
}

/* 图表 */
.box {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
}

.btitle {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2a37;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #1677c8;
}

.chart {
  width: 100%;
  height: 420rpx;
}

.chartdom {
  width: 100%;
  height: 100%;
}

.tips {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8a97a7;
  text-align: center;
}

.empty {
  margin-top: 60rpx;
  text-align: center;
  color: #8a97a7;
  font-size: 26rpx;
}

.blank20 {
  height: 40rpx;
}

/* 品类明细表 */
.subbox {
  margin-top: 18rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 0 10rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
}

.subhead {
  padding: 0 20rpx 14rpx;
}

.subtitle {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2a37;
}

.subsub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a97a7;
}

.subscroll {
  width: 100%;
}

.subtable {
  min-width: 720rpx;
  padding: 0 20rpx 6rpx;
  box-sizing: border-box;
}

.subtr {
  display: flex;
  align-items: stretch;
  margin-bottom: 2rpx;
}

.subth .subtd {
  background: #0e608d;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-color: #0e608d;
}

.subtd2 {
  flex-direction: column;
  gap: 2rpx;
}

.subtr.active .subtd {
  background: #eef7fb;
}

.subtd {
  flex: 1;
  min-height: 96rpx;
  padding: 12rpx 10rpx;
  box-sizing: border-box;
  border: 1rpx solid #141414;
  background: #fff;
  font-size: 24rpx;
  color: #222;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  text-align: center;
  line-height: 1.2;
}

.subarrow {
  width: 20rpx;
  height: auto;
  max-height: 18rpx;
  flex-shrink: 0;
}

.subcell {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.subval {
  font-size: 26rpx;
  font-weight: 600;
  color: #0e608d;
}

.subyoy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.subyoy.up {
  color: #e24a5a;
}

.subyoy.down {
  color: #2f9e79;
}

.col-name {
  flex: 1.15;
}

.subtd.up {
  color: #e24a5a;
}

.subtd.down {
  color: #2f9e79;
}

/* 核心器件供应链分组卡片（对齐数据页 显示供应链DSC） */
.tvsbox {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  background: #fff;
  border: 1rpx solid #e2edf5;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
  overflow: hidden;
}

.tvslist {
  padding: 0 20rpx 6rpx;
}

.tvsgroup-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx 12rpx;
  border-bottom: 1rpx solid #e2edf5;
}

.tvsgroup-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a6fa0;
}

.tvsgroup-periodpicker {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f7fbff;
  border: 1rpx solid #d7e1ea;
}

.tvsgroup-period {
  font-size: 22rpx;
  color: #567089;
}

.tvsrow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f4f7;
}

.tvsrow:last-child {
  border-bottom: 0;
}

.tvsrow-name {
  font-size: 26rpx;
  color: #334155;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tvsrow-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.tvsrow-qty {
  font-size: 30rpx;
  font-weight: 700;
  color: #0e608d;
}

.tvsrow-unit {
  font-size: 22rpx;
  color: #7d8a99;
}

.tvsrow-yoy {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  min-width: 80rpx;
  justify-content: flex-end;
  color: #7d8a99;
}

.tvsrow-yoy.up {
  color: #e24a5a;
}

.tvsrow-yoy.down {
  color: #2f9e79;
}

/* 卡片内箭头（周期胶囊 + 同比涨跌）对齐 DSC 尺寸 */
.tvsgroup-periodpicker .subarrow,
.tvslist .subarrow {
  width: 14rpx;
  max-height: 18rpx;
}
