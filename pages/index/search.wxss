/* pages/index/search.wxss */
page{
	background-color: #ebf6fc;
}
.con{
	padding: 0 25rpx;
	padding-top: 30rpx;
	padding-bottom: 30rpx;
	background-color: #ebf6fc;
	position: relative;
	z-index: 99;
	border-radius: 35rpx 35rpx 0 0 ;
	box-sizing: border-box;
  }
  .swiper {
	--box-width: 100vw;
	height: calc(var(--box-width) / 3.6);
	margin-bottom: 20rpx;
	}
  .swiper-item .pic {
	  border-radius: 20rpx;
  }
  .newsbox {
	width: 100%;
	box-sizing: border-box;
	background-color: #fff;
	border-radius: 20rpx;
	padding: 22rpx 24rpx 8rpx;
	margin-bottom: 25rpx;
	box-shadow: 0 6rpx 20rpx rgba(3,37,60,0.05);
}
.newsbox .newshd{
	padding: 0 2rpx 12rpx;
	font-size: 13px;
	color: #8698a5;
	letter-spacing: 1rpx;
	border-bottom: 1rpx solid #eef3f7;
}
.newsbox .down {
	width: 100%;
}

.newsbox .down .item {
	width: 100%;
	padding: 30rpx 0;
	border-bottom: 1rpx solid #eee;
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.newsbox .down .item {
	border-bottom: 0;
}
.newsbox .down .item .l {
	width: calc(100%);
}
.newsbox .down .item .r {
	width: 120rpx;
	height: auto;
	margin-left: 30rpx;
	flex-shrink: 0;
}
.newsbox .down .item .shang {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	margin-bottom: 20rpx;
}

.newsbox .down .item .shang .pic {
	width: 25rpx;
	margin-right: 15rpx;
	margin-top: 10rpx;
}

.newsbox .down .item .shang .title {
	width: 100%;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
	font-size: 14px;
	color: #333;
}

.newsbox .down .item .xia {
	width: 100%;
	box-sizing: border-box;
	font-size: 12px;
	color: #999;
}
.newsbox .more{
	width: 100%;
	height: 110rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 14px;
	color: #333;
}
.noitem{
	width: 100%;
	font-size: 14px;
	color: #aaa;
	text-align: center;
	background-color: #ebf6fc;
}

/* 相关品类卡片（横向一行胶囊标签，可滑动） */
.catbox{
	width: 100%;
	box-sizing: border-box;
	background-color: #fff;
	border-radius: 20rpx;
	padding: 22rpx 24rpx;
	margin-bottom: 24rpx;
	box-shadow: 0 6rpx 20rpx rgba(3,37,60,0.05);
}
.catbox .cathd{
	padding: 0 2rpx 16rpx;
	font-size: 13px;
	color: #8698a5;
	letter-spacing: 1rpx;
}
.catbox .cattags{
	width: 100%;
	white-space: nowrap;
}
.catbox .cattag{
	display: inline-block;
	vertical-align: middle;
	margin-right: 16rpx;
	padding: 14rpx 28rpx;
	border-radius: 999rpx;
	background-color: #e6f0f7;
	color: #004b7d;
	font-size: 14px;
	font-weight: 600;
	line-height: 1.2;
}
.catbox .cattag:last-child{
	margin-right: 0;
}