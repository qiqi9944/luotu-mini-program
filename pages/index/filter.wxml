<!-- pages/index/filter.wxml -->
<view class="page">

    <!-- 搜索框 -->
    <view class="search">
        <input placeholder="搜索品牌 / 关键词" value="{{keywords}}" bindinput="onSearchInput" bindconfirm="onSearch" />
        <view class="btn" bindtap="onSearch">搜索</view>
    </view>

    <!-- 筛选条件 : 下拉选择 -->
    <view class="filters">
        <view class="fgrid">
            <!-- 市场 -->
            <picker mode="selector" range="{{marketList}}" range-key="name" value="{{marketIdx}}" bindchange="onPickerMarket">
                <view class="fsel">
                    <text class="flabel">市场</text>
                    <text class="fval">{{selMarket||'不限'}}</text>
                    <image src="/pages/images/sanjiao2.png" mode="widthFix" class="farrow"></image>
                </view>
            </picker>
            <!-- 品径 -->
            <picker mode="selector" range="{{lxList}}" range-key="name" value="{{lxIdx}}" bindchange="onPickerLx">
                <view class="fsel">
                    <text class="flabel">品径</text>
                    <text class="fval">{{selLx||'不限'}}</text>
                    <image src="/pages/images/sanjiao2.png" mode="widthFix" class="farrow"></image>
                </view>
            </picker>
            <!-- 品类 -->
            <picker mode="selector" range="{{typeList}}" range-key="name" value="{{typeIdx}}" bindchange="onPickerType">
                <view class="fsel">
                    <text class="flabel">品类</text>
                    <text class="fval">{{selTypeName||'请选择'}}</text>
                    <image src="/pages/images/sanjiao2.png" mode="widthFix" class="farrow"></image>
                </view>
            </picker>
            <!-- 指标 -->
            <picker mode="selector" range="{{xlList}}" range-key="name" value="{{xlIdx}}" bindchange="onPickerXl">
                <view class="fsel">
                    <text class="flabel">指标</text>
                    <text class="fval">{{selXlName}}</text>
                    <image src="/pages/images/sanjiao2.png" mode="widthFix" class="farrow"></image>
                </view>
            </picker>
            <!-- 时间 -->
            <picker mode="selector" range="{{timeList}}" range-key="name" value="{{timeIdx}}" bindchange="onPickerTime">
                <view class="fsel">
                    <text class="flabel">时间</text>
                    <text class="fval">{{selTimeName}}</text>
                    <image src="/pages/images/sanjiao2.png" mode="widthFix" class="farrow"></image>
                </view>
            </picker>
            <!-- 年累计 -->
            <picker mode="selector" range="{{ytdList}}" range-key="name" value="{{ytdIdx}}" bindchange="onPickerYtd">
                <view class="fsel">
                    <text class="flabel">累计</text>
                    <text class="fval">{{ytd==1?'年累计':'当期'}}</text>
                    <image src="/pages/images/sanjiao2.png" mode="widthFix" class="farrow"></image>
                </view>
            </picker>
        </view>
    </view>

    <!-- 内容 -->
    <view class="con empty" wx:if="{{empty}}">
        <view class="text">暂无数据，敬请期待...</view>
    </view>

    <view class="con" wx:else>
        <!-- 当前选择摘要 -->
        <view class="cursel">当前：{{selTypeName?selTypeName:'未选品类'}}{{selMarket?' · '+selMarket:''}}{{selLx?' · '+selLx:''}}{{selTimeName?' · '+selTimeName:''}}{{ytd==1?' · 年累计':''}}<text class="ver">v{{ver}}</text></view>
        <!-- 指标卡 -->
        <view class="ind">
            <view class="inditem {{xqData.length==1?'ind2':''}}" wx:for="{{xqData}}" wx:key="t1">
                <view class="p1">{{item.t1}}</view>
                <view class="p2">
                    <text class="num">{{item.t2}}</text><text class="dw">{{item.dw}}</text>
                </view>
                <view class="p3 {{item.t3[0]=='+'?'up':item.t3[0]=='-'?'down':''}}">同比 {{item.t3}}</view>
            </view>
        </view>

        <!-- 市场规模 -->
        <view class="box">
            <view class="btitle">市场规模趋势（{{arr_sj2_dw}}）</view>
            <view class="chart">
                <ec-canvas id="mychart-dom-bar" class="chartdom" canvas-id="bar1" ec="{{ec}}"></ec-canvas>
            </view>
        </view>

        <!-- 品牌份额 -->
        <view class="box" hidden="{{!chart2x.length}}">
            <view class="btitle">品牌销量份额(%)</view>
            <view class="chart">
                <ec-canvas id="mychart-dom-bar2" class="chartdom" canvas-id="bar2" ec="{{ec2}}"></ec-canvas>
            </view>
        </view>

        <!-- 产品结构 -->
        <view class="box" hidden="{{!chart4.length}}">
            <view class="btitle">产品/价格结构(%)</view>
            <view class="chart">
                <ec-canvas id="mychart-dom-bar3" class="chartdom" canvas-id="bar3" ec="{{ec3}}"></ec-canvas>
            </view>
        </view>

        <view class="tips" wx:if="{{tips}}">{{tips}}</view>
        <view class="blank20"></view>
    </view>
</view>
