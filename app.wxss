/**app.wxss — 洛图科技 · 设计令牌层
 * 设计方向：明亮天蓝，面向显示产业分析师的数据界面。
 * 浅蓝页眉、白色卡片，天蓝强调；深色文字保证数据可读。
 * 数字使用等宽字形，让纵向数列自然对齐。
 * 约定：所有新增样式只使用 rpx 与下列变量，不再硬编码色值。
 */
page {
	width: 100%;
	height: 100%;

	/* —— 品牌蓝：用于图标、选中标记和图表 —— */
	--brand: #055586;
	--brand-soft: #eaf5ff;
	--header-bg: linear-gradient(160deg, #eaf5ff 0%, #dcebff 100%);

	/* —— 文字与实色按钮：保留足够对比度 —— */
	--ink-900: #083047;
	--ink-800: #0a3f5e;
	--ink-700: #055586;
	--ink-600: #055586;
	--ink-400: #62b5ff;
	--ink-200: #c9e5ff;
	--ink-050: #eaf5ff;

	/* —— 纸面（整体提亮、更通透）—— */
	--paper: #f5faff;
	--surface: #ffffff;
	--surface-sunken: #f8fbff;

	/* —— 文字 —— */
	--text-1: #12212b;
	--text-2: #4a5c68;
	--text-3: #8698a5;
	--text-invert: #ffffff;

	/* —— 发丝分隔线 —— */
	--hairline: rgba(5, 85, 134, 0.14);
	--hairline-strong: rgba(5, 85, 134, 0.24);

	/* —— 唯一强调色：信号琥珀（提亮更跳眼）—— */
	--signal: #ffb547;
	--signal-soft: #fff4e2;

	/* —— 涨跌：延续「红涨绿跌」惯例，提高饱和度与对比 —— */
	--rise: #CA3828;
	--fall: #00B050;
	--flat: #8698a5;

	/* —— 标准色板：与产品结构饼图 color 数组同源 ——
	   品牌蓝 / 品牌红为主锚点，其余为分类标识扩展色。
	   仅用于「分类」语义（宫格、标签、序号），不参与涨跌语义。 */
	--c-blue: #055586;
	--c-red: #CA3828;
	--c-indigo: #7188f0;
	--c-green: #55bc8a;
	--c-amber: #ffd166;
	--c-orange: #ffa56b;
	--c-cyan: #62c8e8;
	--c-violet: #b18ae0;
	--c-magenta: #f39bd9;

	/* 分类浅底：各主色约 8% 提亮，预先调好以规避 color-mix 兼容性 */
	--c-blue-soft: #eaf5ff;
	--c-red-soft: #fff0ed;
	--c-indigo-soft: #eef1ff;
	--c-green-soft: #eaf9f1;
	--c-amber-soft: #fff7e3;
	--c-orange-soft: #fff1e7;
	--c-cyan-soft: #e9f9ff;
	--c-violet-soft: #f5efff;
	--c-magenta-soft: #fff0fa;

	/* 分类文字色：主色压暗至可读对比度（≥4.5:1） */
	--c-blue-ink: #055586;
	--c-red-ink: #CA3828;
	--c-indigo-ink: #3f57a0;
	--c-green-ink: #2c7d57;
	--c-amber-ink: #96600f;
	--c-orange-ink: #b34a1f;
	--c-cyan-ink: #1f7fa3;
	--c-violet-ink: #7a4892;
	--c-magenta-ink: #b34a94;

	/* —— 字阶（统一 rpx，杜绝 px/rpx 混用）—— */
	--fs-caption: 22rpx;
	--fs-body-s: 24rpx;
	--fs-body: 28rpx;
	--fs-title: 32rpx;
	--fs-heading: 38rpx;
	--fs-metric: 52rpx;
	--fs-metric-lg: 64rpx;

	/* —— 半径 / 间距 / 阴影 —— */
	--r-sm: 8rpx;
	--r-md: 16rpx;
	--r-lg: 24rpx;
	--r-sheet: 32rpx;
	--gutter: 28rpx;
	--shadow-card: 0 2rpx 8rpx rgba(3, 37, 60, 0.04), 0 12rpx 30rpx rgba(3, 37, 60, 0.05);
	--shadow-lift: 0 4rpx 12rpx rgba(3, 37, 60, 0.08), 0 20rpx 44rpx rgba(3, 37, 60, 0.09);

	/* —— 字体 —— */
	--font-text: -apple-system, "PingFang SC", "Helvetica Neue", "Source Han Sans SC", sans-serif;
	/* 数字专用：iOS 上取 DIN Alternate（几何感强、字宽等距），
	   其他平台退回系统无衬线，真正的列对齐交给 tabular-nums 保证。
	   刻意不放 *Condensed 字族，避免安卓上数字忽然变窄。 */
	--font-num: "DIN Alternate", "SF Pro Display", -apple-system, "Helvetica Neue", sans-serif;

	background-color: var(--paper);
	color: var(--text-1);
	font-family: var(--font-text);
	-webkit-font-smoothing: antialiased;
}

/* ==========================================================================
   1. 通用原语
   ========================================================================== */

/* 数字：等宽字形 + 紧凑字距，让表格与指标纵向成列 */
.num,
.num2,
.num3,
.metric {
	font-family: var(--font-num);
	font-variant-numeric: tabular-nums;
	font-feature-settings: "tnum" 1, "lnum" 1;
	letter-spacing: 0;
}

/* 涨跌语义色 */
.hong {
	color: var(--rise);
}
.lv {
	color: var(--fall);
}

/* 间距占位（沿用旧类名，页面无需改动） */
.blank20 {
	height: 24rpx;
}
.blank10 {
	height: 12rpx;
}

.main {
	padding: 0 var(--gutter);
}

/* 卡片：单层描边 + 极轻投影，不再「描边+重阴影」双重堆叠 */
.card {
	background-color: var(--surface);
	border-radius: var(--r-lg);
	box-shadow: var(--shadow-card);
	box-sizing: border-box;
}

/* 区块标题：以细长墨条替代通用色块，右侧留出操作位 */
.sec-head {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 22rpx;
}
.sec-head .sec-title {
	display: flex;
	align-items: center;
	font-size: var(--fs-title);
	font-weight: 600;
	color: var(--text-1);
	letter-spacing: 0.5rpx;
}
.sec-head .sec-title::before {
	content: "";
	width: 6rpx;
	height: 30rpx;
	margin-right: 14rpx;
	border-radius: 6rpx;
	flex-shrink: 0;
	background: linear-gradient(180deg, var(--c-amber) 0%, var(--signal) 100%);
}

/* ==========================================================================
   2. 数据表格 —— 去掉纵向网格线，只留横向发丝线 + 斑马纹
   ========================================================================== */
.table {
	width: 100%;
	border: 0;
	border-radius: var(--r-md);
	overflow: hidden;
	box-sizing: border-box;
}

.tr {
	display: flex;
	width: 100%;
	justify-content: center;
	align-items: stretch;
}

/* 表头：下沉底色 + 小字号说明体，与数据行形成层级 */
.th {
	display: flex;
	justify-content: center;
	align-items: center;
	flex-wrap: wrap;
	min-height: 64rpx;
	box-sizing: border-box;
	padding: 10rpx 12rpx;
	border: 0;
	background-color: var(--ink-050);
	font-size: var(--fs-caption);
	line-height: 1.3;
	font-weight: 600;
	color: var(--ink-700);
	text-align: center;
	word-break: break-all;
}

.td {
	display: flex;
	justify-content: center;
	align-items: center;
	flex-wrap: wrap;
	min-height: 84rpx;
	box-sizing: border-box;
	padding: 10rpx 12rpx;
	border: 0;
	border-bottom: 1rpx solid var(--hairline);
	background-color: var(--surface);
	font-size: var(--fs-body-s);
	line-height: 1.35;
	color: var(--text-2);
	word-break: break-all;
}

/* 斑马纹：表头为第 1 行，故偶数行即首个数据行 */
.tr:nth-child(even) .td {
	background-color: var(--surface-sunken);
}
.tr:last-child .td {
	border-bottom: 0;
}

/* 表内数字 */
.td .num {
	font-size: var(--fs-body);
	font-weight: 700;
	color: var(--ink-700);
}
.td .num2 {
	font-size: var(--fs-caption);
	font-weight: 700;
	color: var(--flat);
}
.td .dw {
	font-size: var(--fs-caption);
	color: var(--text-3);
	margin-left: 4rpx;
}

/* 列宽 */
.wd20 {
	width: 20%;
}
.wd26 {
	width: 26%;
}
.wd30 {
	width: 30%;
}
.wd33 {
	width: calc(100% / 3);
}
.wd35 {
	width: 35%;
}
.wd36 {
	width: 36%;
}
.wd38 {
	width: 38%;
}
.wd40 {
	width: 40%;
}

/* ==========================================================================
   3. 浅蓝页眉带 —— 清亮底色 + 细网格纹（纯 CSS，零图片请求）
   ========================================================================== */
.sellist {
	position: relative;
	/* 保持与改版前一致的 40/80 上下留白，以免 7 个复用此类的页面
	   （list / next1 / next2 / news / scdz / yanbao 等）整体位移 */
	padding: 40rpx 0 80rpx;
	box-sizing: border-box;
	display: flex;
	justify-content: space-around;
	align-items: center;
	overflow: hidden;
	background: var(--header-bg);
}

/* 45° 蓝图纹：两组重复线性渐变交叉，营造制图纸质感 */
.sellist::before {
	content: "";
	position: absolute;
	left: -20%;
	top: -60%;
	width: 140%;
	height: 260%;
	pointer-events: none;
	background-image: repeating-linear-gradient(
			45deg,
			rgba(5, 85, 134, 0.045) 0 1rpx,
			transparent 1rpx 24rpx
		),
		repeating-linear-gradient(-45deg, rgba(5, 85, 134, 0.03) 0 1rpx, transparent 1rpx 24rpx);
}

/* 右上角一抹冷光，破除纯色的平板感 */
.sellist::after {
	content: "";
	position: absolute;
	right: -80rpx;
	top: -140rpx;
	width: 420rpx;
	height: 420rpx;
	border-radius: 50%;
	pointer-events: none;
	background: radial-gradient(circle, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0) 70%);
}

.sellist .item {
	position: relative;
	z-index: 1;
	font-size: var(--fs-body);
	color: var(--text-2);
	letter-spacing: 1rpx;
	transition: color 0.2s ease;
}
/* 激活项：可读蓝字 + 天蓝短横 */
.sellist .item.hover {
	color: var(--ink-700);
	font-weight: 600;
}
.sellist .item.hover::after {
	content: "";
	position: absolute;
	left: 50%;
	bottom: -14rpx;
	width: 40rpx;
	height: 5rpx;
	margin-left: -20rpx;
	border-radius: 5rpx;
	background: var(--brand);
}

/* ==========================================================================
   4. 轮播
   ========================================================================== */
.swiper {
	--box-width: 100vw;
	height: calc(var(--box-width) / 3.6);
	margin-bottom: 24rpx;
}

swiper {
	height: 100%;
}

swiper-item {
	height: auto !important;
}

.swiper-item {
	width: 100%;
	background-repeat: no-repeat;
	background-position: center;
	background-size: cover;
	border-radius: var(--r-md);
	overflow: hidden;
}

.swiper-item .pic {
	width: 100%;
}

/* ==========================================================================
   5. 触摸反馈（配合 hover-class 使用，小程序 view 上 :active 不可靠）
   ========================================================================== */
.tap-card {
	transform: scale(0.972);
	opacity: 0.92;
	transition: transform 0.12s ease-out, opacity 0.12s ease-out;
}

.tap-row {
	background-color: var(--ink-050) !important;
}

.tap-dim {
	opacity: 0.6;
}

/* 可点击元素统一给出过渡，松手时回弹而非跳变 */
.tappable {
	transition: transform 0.18s cubic-bezier(0.2, 0.8, 0.3, 1), opacity 0.18s ease;
}

/* ==========================================================================
   6. 入场动效 —— 一次编排好的错峰上浮，胜过零散的微交互
   ========================================================================== */
@keyframes rise-in {
	from {
		opacity: 0;
		transform: translateY(18rpx);
	}
	to {
		opacity: 1;
		transform: translateY(0);
	}
}

.rise {
	animation: rise-in 0.42s cubic-bezier(0.22, 0.85, 0.28, 1) both;
}
.rise-1 {
	animation-delay: 0.04s;
}
.rise-2 {
	animation-delay: 0.1s;
}
.rise-3 {
	animation-delay: 0.16s;
}
.rise-4 {
	animation-delay: 0.22s;
}

/* 底部安全区，避免内容被 tabBar / 手势条压住 */
.safe-bottom {
	height: calc(24rpx + env(safe-area-inset-bottom));
}
