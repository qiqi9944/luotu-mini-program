/* pages/index/next1.wxss */
.sellist {
	padding-bottom: 110rpx;
}
.con{
	padding: 0 25rpx;
	padding-top: 30rpx;
	padding-bottom: 30rpx;
	background-color: #ebf6fc;
	margin-top: -70rpx;
	position: relative;
	z-index: 99;
	border-radius: 35rpx 35rpx 0 0 ;
	box-sizing: border-box;
  }
  .sellist {
	  padding-bottom: 110rpx;
  }
  .swiper {
	--box-width: 100vw;
	height: calc(var(--box-width) / 3.6);
	margin-bottom: 20rpx;
	}
  .swiper-item .pic {
	  border-radius: 20rpx;
  }
  .newsbox {
	width: 100%;
	background-color: #fff;
	margin-bottom: 25rpx;
}
.newsbox .down {
	width: 100%;
}

.newsbox .down .item {
	width: 100%;
	padding: 30rpx 0;
	border-bottom: 1rpx solid #eee;
	display: flex;
	justify-content: space-between;
	align-items: center;
}
.newsbox .down .item {
	border-bottom: 0;
}
.newsbox .down .item .l {
	width: calc(100%);
}
.newsbox .down .item .r {
	width: 120rpx;
	height: auto;
	margin-left: 30rpx;
	flex-shrink: 0;
}
.newsbox .down .item .shang {
	width: 100%;
	display: flex;
	justify-content: flex-start;
	align-items: flex-start;
	margin-bottom: 20rpx;
}

.newsbox .down .item .shang .pic {
	width: 25rpx;
	margin-right: 15rpx;
	margin-top: 10rpx;
	max-height: 13px;
}

.newsbox .down .item .shang .title {
	width: 100%;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
	font-size: 14px;
	color: #333;
}

.newsbox .down .item .xia {
	width: 100%;
	box-sizing: border-box;
	font-size: 12px;
	color: #999;
}
.newsbox .more{
	width: 100%;
	height: 110rpx;
	display: flex;
	justify-content: center;
	align-items: center;
	font-size: 14px;
	color: #333;
}