/* pages/index/filter.wxss */
page {
  background: var(--paper);
}

.page {
  padding: 18rpx 18rpx 28rpx;
  box-sizing: border-box;
}

/* 筛选 */
.filters {
  margin-top: 14rpx;
  background: var(--surface);
  border-radius: var(--r-lg);
  padding: 20rpx 18rpx 8rpx;
  box-shadow: var(--shadow-card);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2a37;
}

.section-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a97a7;
}

.filter-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.picker-item {
  width: calc((100% - 24rpx) / 3);
  display: block;
}

.fsel {
  width: 100%;
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 16rpx 16rpx 14rpx;
  margin-bottom: 12rpx;
  background: var(--surface-sunken);
  border: 1rpx solid var(--hairline-strong);
  border-radius: var(--r-md);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
  transition: background-color 0.15s ease, border-color 0.15s ease;
}

.fsel:active {
  background: var(--ink-050);
  border-color: var(--ink-400);
}

.flabel {
  font-size: 20rpx;
  color: var(--text-3);
  font-weight: 500;
  line-height: 1;
}

.fmeta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.fval {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-700);
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: left;
  line-height: 1;
}

.farrow {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  opacity: 0.45;
}

/* 指标卡 */
.ind {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.inditem {
  width: calc((100% - 24rpx) / 3);
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
}

.ind2 {
  width: 100%;
}

.inditem .p1 {
  font-size: 24rpx;
  color: #7d8a99;
}

.inditem .p2 {
  margin: 12rpx 0 10rpx;
}

.inditem .num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1677c8;
}

.inditem .dw {
  font-size: 22rpx;
  color: #7d8a99;
  margin-left: 6rpx;
}

.inditem .p3 {
  font-size: 22rpx;
  color: #7d8a99;
}

.inditem .p3.up {
  color: #e04a5c;
}

.inditem .p3.down {
  color: #2f9e79;
}

/* 图表 */
.box {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
}

.btitle {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2a37;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
  border-left: 6rpx solid #1677c8;
}

.chart {
  width: 100%;
  height: 420rpx;
}

.chartdom {
  width: 100%;
  height: 100%;
}

.tips {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8a97a7;
  text-align: center;
}

.empty {
  margin-top: 60rpx;
  text-align: center;
  color: #8a97a7;
  font-size: 26rpx;
}

.blank20 {
  height: 40rpx;
}

/* 品类明细表 */
.subbox {
  margin-top: 18rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 18rpx 0 10rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
  overflow: hidden;
}

.subhead {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 0 20rpx 16rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.subtitle {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2a37;
  display: flex;
  align-items: center;
}

.subtitle::before {
  content: "";
  width: 6rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, var(--c-blue) 0%, var(--ink-700) 100%);
}

.subsub {
  font-size: 22rpx;
  color: #8a97a7;
}

.subscroll {
  width: 100%;
}

.subtable {
  width: 100%;
  min-width: 0;
  padding: 0 20rpx 6rpx;
  box-sizing: border-box;
}

.subtr {
  display: flex;
  align-items: stretch;
}

/* 表头：实心浅蓝底 + 墨蓝粗字 + 底部墨蓝分隔条，做成一条明确的表头带 */
.subth .subtd {
  background: var(--ink-050);
  color: var(--ink-700);
  font-size: 24rpx;
  font-weight: 700;
  min-height: 76rpx;
  border-bottom: 3rpx solid var(--ink-200);
  border-radius: 0;
}

.subth .subtd:first-child {
  border-radius: 10rpx 0 0 0;
}

.subth .subtd:last-child {
  border-radius: 0 10rpx 0 0;
}

/* 数据格：去黑粗边，只用发丝线分隔，横向成列、纵向连贯 */
.subtd {
  flex: 1;
  min-width: 0;
  min-height: 76rpx;
  padding: 12rpx 6rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--hairline-strong);
  background: #fff;
  font-size: 24rpx;
  color: var(--text-2);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  text-align: center;
  line-height: 1.2;
  white-space: nowrap;
}

/* 数字列：等宽字形、右对齐、不换行，纵向成列，涨跌箭头贴在数字后 */
.subtr .subtd:not(.col-name) {
  font-family: var(--font-num);
  font-variant-numeric: tabular-nums;
  font-size: 22rpx;
  font-weight: 600;
  justify-content: flex-end;
  padding-right: 16rpx;
}

/* 数字后缀单位：小一号中性灰，不参与等宽数字排版 */
.unit {
  margin-left: 2rpx;
  font-family: var(--font-text);
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-3);
}

/* 末行去底边线，表体收口 */
.subtr:last-child .subtd {
  border-bottom: 0;
}

/* 斑马纹：表头为第 1 行，偶数行即奇数数据行；用中性浅灰，避免与蓝色表头撞色 */
.subtr:nth-child(even):not(.subth) .subtd {
  background: var(--surface-sunken);
}

/* 选中行：淡蓝图底色，上下加细线强调 */
.subtr.active .subtd {
  background: var(--ink-050);
}

.subtd2 {
  flex-direction: column;
  gap: 2rpx;
}

.subarrow {
  width: 18rpx;
  height: auto;
  max-height: 16rpx;
  flex-shrink: 0;
}

.subcell {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.subval {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-blue);
}

.subyoy {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.subyoy.up {
  color: var(--rise);
}

.subyoy.down {
  color: var(--fall);
}

.col-name {
  flex: none;
  width: 172rpx;
  min-width: 172rpx;
  justify-content: flex-start;
  text-align: left;
  padding-left: 14rpx;
  color: var(--text-1);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  border-right: 1rpx solid var(--hairline-strong);
}

.subtd.up {
  color: var(--rise);
}

.subtd.down {
  color: var(--fall);
}

/* 核心器件供应链分组卡片（对齐数据页 显示供应链DSC） */
.tvsbox {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  background: #fff;
  border: 1rpx solid #e2edf5;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 28rpx rgba(24, 58, 95, 0.05);
  overflow: hidden;
}

.tvslist {
  padding: 0 20rpx 6rpx;
}

.tvsgroup-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 20rpx 12rpx;
  border-bottom: 1rpx solid #e2edf5;
}

.tvsgroup-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a6fa0;
}

.tvsgroup-periodpicker {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f7fbff;
  border: 1rpx solid #d7e1ea;
}

.tvsgroup-period {
  font-size: 22rpx;
  color: #567089;
}

.tvsrow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f4f7;
}

.tvsrow:last-child {
  border-bottom: 0;
}

.tvsrow-name {
  font-size: 26rpx;
  color: #334155;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tvsrow-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.tvsrow-qty {
  font-size: 30rpx;
  font-weight: 700;
  color: #0e608d;
}

.tvsrow-unit {
  font-size: 22rpx;
  color: #7d8a99;
}

.tvsrow-yoy {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  min-width: 80rpx;
  justify-content: flex-end;
  color: #7d8a99;
}

.tvsrow-yoy.up {
  color: #e24a5a;
}

.tvsrow-yoy.down {
  color: #2f9e79;
}

/* 卡片内箭头（周期胶囊 + 同比涨跌）对齐 DSC 尺寸 */
.tvsgroup-periodpicker .subarrow,
.tvslist .subarrow {
  width: 14rpx;
  max-height: 18rpx;
}
