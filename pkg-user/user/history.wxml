<view class="top"></view>
<view class="con">
	<view class="hislist">
		<block wx:for="{{hislist}}" wx:key="id">
			<view class="item" data-url="{{item.url}}" data-type="{{item.type}}" bindtap="clickpage">
				<view class="up">{{item.addtime}}</view>
				<view class="down"><image src="/pages/images/hispic.png" mode="widthFix" class="img"></image>{{item.name}}</view>
			</view>
		</block>
		<view class="more" wx:if="{{!lastpage}}"  bindtap="getnews">查看更多 ></view>
	</view>
</view>